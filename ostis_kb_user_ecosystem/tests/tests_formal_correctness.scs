test_transition_traceability => nrel_question_subject: transition_rec_replan;;
test_transition_traceability => nrel_test_outcome: concept_test_outcome_pass;;
test_transition_traceability => nrel_expected_answer: answer_t14;;

answer_t14 <- concept_expected_answer;;
answer_t14 => nrel_main_idtf:
    [Выполнено: from_state = x_assign, to_state = x_replan,
     caused_by_event = budget_exhausted_rec,
     uses_plan_version = plan_rec_v2,
     transition_recorded_in = audit_rec_replan,
     has_provenance(audit_rec_replan, prov_rec_replan).]
    (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// T15: Отрицательный тест — запрет доступа при передаче данных.
// ---------------------------------------------------------------------

test_access_denied <- concept_test_constraint_check;;
test_access_denied => nrel_main_idtf:
    [T15. Отрицательный тест: передача проекции контекста участнику,
     не разрешённому политикой (permits отсутствует)]
    (* <- lang_ru;; *);;
test_access_denied => nrel_test_against_constraint:
