answer_t20 <- concept_expected_answer;;
answer_t20 => nrel_main_idtf:
    [Выполнено: result_energy — ProcessingResult с produced_by,
     generated_by и контекстом; integrated_result_001 — IntegratedResult
     с aggregates, verified, объяснением, контекстом и provenance.
     Интегрированный результат не классифицирован ProcessingResult
     и не имеет обязательного generated_by.]
    (* <- lang_ru;; *);;


