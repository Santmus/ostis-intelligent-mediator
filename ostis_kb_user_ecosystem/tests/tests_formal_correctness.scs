test_phase_transition_bound => nrel_expected_answer: answer_t22;;

answer_t22 <- concept_expected_answer;;
answer_t22 => nrel_main_idtf:
    [Выполнено: Φ = <n_clar_rem, d_rem, n_pend + b_rem> не возрастает
