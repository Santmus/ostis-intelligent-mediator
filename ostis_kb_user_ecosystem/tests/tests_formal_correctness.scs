// ---------------------------------------------------------------------
// T20: Дизъюнктность частичного и интегрированного результатов.
// ---------------------------------------------------------------------

test_result_taxonomy <- concept_test_constraint_check;;
test_result_taxonomy => nrel_main_idtf:
    [T20. result_energy и integrated_result_001 принадлежат разным
