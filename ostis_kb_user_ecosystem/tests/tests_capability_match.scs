// =====================================================================
// tests/tests_capability_match.scs
// Проверки match, допустимости и формирования коалиции.
// =====================================================================

section_tests_capability_match
=> nrel_main_idtf:
    [Подраздел. Тесты функции match(σ, s | C) и формирования коалиции]
    (* <- lang_ru;; *);
    [Subsection. Capability Match Function Tests] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: concept_test_capability_match;;

concept_test_capability_match
<- sc_node_class;
=> nrel_main_idtf:
    [тест функции применимости match(σ, s | C)] (* <- lang_ru;; *);;
concept_test_capability_match <= nrel_strict_inclusion: concept_test_question;;

// Веса по умолчанию: w_R = 0.25, остальные пять по 0.15; θ = 0.70.

// ---------------------------------------------------------------------
// TM1: Полный числовой расчёт match.
// ---------------------------------------------------------------------

test_match_energy_estimation <- concept_test_capability_match;;
test_match_energy_estimation => nrel_main_idtf:
    [TM1. match(subtask_energy_estimation, intelligent_system_energy_model | C)
     при весах w = (0.15, 0.15, 0.15, 0.15, 0.15, 0.25)]
    (* <- lang_ru;; *);;
test_match_energy_estimation => nrel_test_calculation:
    [sim_T = 1.00;
     sim_In = 0.95;
     sim_Out = 0.95;
     ctx_compat = 0.90;
     qos = 0.87;
     trust(s, σ | C_h(s)) = 0.91;
     match = 0.15·1.00 + 0.15·0.95 + 0.15·0.95 + 0.15·0.90
           + 0.15·0.87 + 0.25·0.91 = 0.928]
    (* <- lang_ru;; *);;
test_match_energy_estimation => nrel_expected_answer: answer_tm1;;

answer_tm1 <- concept_expected_answer;;
answer_tm1 => nrel_main_idtf:
    [match = 0.928 ≥ θ = 0.70. Первый конъюнкт assignable выполнен;
     назначение допустимо только при valid = permit = available = 1.]
    (* <- lang_ru;; *);;

// TM2–TM4 не содержат полной покомпонентной разбивки, поэтому их
// агрегированные значения остаются иллюстративными и не пересчитываются.

// ---------------------------------------------------------------------
// TM2: Ранжирование кандидатов после проверки допустимости.
// ---------------------------------------------------------------------

test_match_ranking_alternatives <- concept_test_capability_match;;
test_match_ranking_alternatives => nrel_main_idtf:
    [TM2. Сравнение трёх ИС-кандидатов на subtask_ranking]
    (* <- lang_ru;; *);;
test_match_ranking_alternatives => nrel_test_calculation:
    [match(σ_ranking, ranker_v1 | C) = 0.84;
     match(σ_ranking, ranker_alt | C) = 0.79;
     match(σ_ranking, hybrid_ranker | C) = 0.72.
     Все проходят θ = 0.70; включение в S_(σ,C) дополнительно требует
     valid = permit = available = 1. При k = 1 выбирается ranker_v1
     как наибольший match среди допустимых.] (* <- lang_ru;; *);;
test_match_ranking_alternatives => nrel_expected_answer:
    answer_tm2;;

answer_tm2 <- concept_expected_answer;;
answer_tm2 => nrel_main_idtf:
    [χ(σ_ranking) = {intelligent_system_ranker} при выполнении всех
     четырёх условий assignable.] (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// TM3: Пересчёт после изменения доверия.
// ---------------------------------------------------------------------

test_match_after_failure <- concept_test_capability_match;;
test_match_after_failure => nrel_main_idtf:
    [TM3. После отказа ranker_v1 и понижения trust значение match
     пересчитывается по обновлённой C_h(s). Понижение доверия не
     увеличивает match при неотрицательном w_R. Если match становится
     ниже θ, участник исключается из S_(σ,C).]
    (* <- lang_ru;; *);;
test_match_after_failure => nrel_expected_answer: answer_tm3;;

answer_tm3 <- concept_expected_answer;;
answer_tm3 => nrel_main_idtf:
    [После исключения отказавшего выбирается допустимый кандидат
     с наибольшим match; переназначение расходует b_q.]
    (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// TM4: Покрытие и точность при сепарабельных ограничениях.
// ---------------------------------------------------------------------

test_coverage_optimization <- concept_test_capability_match;;
test_coverage_optimization => nrel_main_idtf:
    [TM4. Для T(request_001) найти χ* с максимальной суммой match
     при assignable, |χ(σ)| = k(σ), cover = 1 и consistent = 1.]
    (* <- lang_ru;; *);;
test_coverage_optimization => nrel_test_calculation:
    [Σ match = match(σ_route, ostis_route_planner | C) +
              match(σ_energy, energy_model | C) +
              match(σ_ranking, ranker_v1 | C);
     второе слагаемое пересчитано в TM1 и равно 0.928;
     назначения независимы, поэтому покомпонентный максимум совпадает
     с максимумом суммы и даёт точное решение.]
    (* <- lang_ru;; *);;
test_coverage_optimization => nrel_expected_answer: answer_tm4;;

answer_tm4 <- concept_expected_answer;;
answer_tm4 => nrel_main_idtf:
    [χ* = {(σ_route → route_planner),
           (σ_energy → energy_model),
           (σ_ranking → ranker_v1)}; cover(χ*, T(request_001)) = 1.]
    (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// TM5: Мера Ву—Палмера для типов задач.
// ---------------------------------------------------------------------

test_task_type_similarity <- concept_test_capability_match;;
test_task_type_similarity => nrel_main_idtf:
    [TM5. sim_T вычисляется по ближайшему общему надклассу и глубинам
     типов; при совпадении типов мера равна 1.]
    (* <- lang_ru;; *);;
test_task_type_similarity => nrel_test_calculation:
    [sim_T(τ, {τ}) = 2·depth(τ) / (depth(τ) + depth(τ)) = 1.
     Для разных типов используется depth(lcs(τ_σ, τ_s));
     по множеству T_s берётся максимум.] (* <- lang_ru;; *);;
test_task_type_similarity => nrel_expected_answer: answer_tm5;;

answer_tm5 <- concept_expected_answer;;
answer_tm5 => nrel_main_idtf:
    [Выполнено: формула Ву—Палмера задана без свободных параметров;
     одной подходящей компетенции участника достаточно.]
    (* <- lang_ru;; *);;

nrel_test_calculation
<- sc_node_non_role_relation;
=> nrel_main_idtf: [вычисление_теста*] (* <- lang_ru;; *);
<- binary_relation;;
