// =====================================================================
// tests/tests_navigation.scs
// Тесты навигации по базе знаний. Каждый тест — экземпляр класса
// concept_test_question с ожидаемым ответом, выраженным как sc-структура
// либо ссылка на ключевой sc-элемент. Соответствует паттерну
// general_specification IMS.ostis [спецификации поиска].
// =====================================================================

section_tests_navigation
=> nrel_main_idtf:
    [Подраздел. Тесты навигации по базе знаний] (* <- lang_ru;; *);
    [Subsection. Knowledge Base Navigation Tests] (* <- lang_en;; *);
<- atomic_section;
<- not_enough_formed_structure;
<- rrel_key_sc_element: concept_test_question;
<- rrel_key_sc_element: concept_expected_answer;;

// ---------------------------------------------------------------------
// Корневые классы тестов.
// ---------------------------------------------------------------------

concept_test_question
<- sc_node_class;
=> nrel_main_idtf:
    [тестовый вопрос к базе знаний] (* <- lang_ru;; *);
    [test question to knowledge base] (* <- lang_en;; *);;

concept_expected_answer
<- sc_node_class;
=> nrel_main_idtf:
    [ожидаемый ответ на тестовый вопрос] (* <- lang_ru;; *);
    [expected test answer] (* <- lang_en;; *);;

nrel_expected_answer
<- sc_node_non_role_relation;
=> nrel_main_idtf: [ожидаемый_ответ*] (* <- lang_ru;; *);
=> nrel_main_idtf: [expected_answer*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_test_question;
=> nrel_second_domain: concept_expected_answer;;

nrel_question_subject
<- sc_node_non_role_relation;
=> nrel_main_idtf: [предмет_вопроса*] (* <- lang_ru;; *);
=> nrel_main_idtf: [question_subject*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;;

nrel_uses_specification
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [использует_спецификацию_поиска*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;;

// ---------------------------------------------------------------------
// Q1: Где определён класс concept_user?
// ---------------------------------------------------------------------

question_where_defined_user <- concept_test_question;;
question_where_defined_user => nrel_main_idtf:
    [Q1. В каком подразделе определён класс concept_user?]
    (* <- lang_ru;; *);;
question_where_defined_user => nrel_question_subject: concept_user;;
question_where_defined_user => nrel_uses_specification:
    spec_finding_section_for_concept;;

answer_q1 <- concept_expected_answer;;
answer_q1 => nrel_main_idtf:
    [section_concept_users (файл concepts/users.scs)]
    (* <- lang_ru;; *);;
question_where_defined_user => nrel_expected_answer: answer_q1;;

// ---------------------------------------------------------------------
// Q2: Основные и вспомогательные процессы жизненного цикла π.
// ---------------------------------------------------------------------

question_enumerate_lifecycle_processes <- concept_test_question;;
question_enumerate_lifecycle_processes => nrel_main_idtf:
    [Q2. Перечислите восемь основных и два вспомогательных процесса
     жизненного цикла π и соответствующие им sc-агенты посредника.]
    (* <- lang_ru;; *);;
question_enumerate_lifecycle_processes => nrel_question_subject:
    concept_lifecycle_process;;

answer_q2 <- concept_expected_answer;;
answer_q2 => nrel_main_idtf:
    [(π_int, agent_request_interpreter),
     (π_dec, agent_task_decomposer),
     (π_all, agent_task_allocator),
     (π_coop, agent_cooperative_executor),
     (π_intg, agent_result_integrator),
     (π_exp, agent_explanation_builder),
     (π_tr, agent_trust_evaluator),
     (π_rec, agent_coalition_reconfigurator),
     (LifecycleMonitoring, сбор событий UserInteractionEvent),
     (UserModelActualization, agent_user_model_updater —
      онтологическая спецификация без программной реализации)]
    (* <- lang_ru;; *);;
question_enumerate_lifecycle_processes => nrel_expected_answer: answer_q2;;

// ---------------------------------------------------------------------
// Q3: Композиция контекста C.
// ---------------------------------------------------------------------

question_context_composition <- concept_test_question;;
question_context_composition => nrel_main_idtf:
    [Q3. Какие пять подконтекстов образуют контекст взаимодействия C?]
    (* <- lang_ru;; *);;
question_context_composition => nrel_question_subject:
    concept_interaction_context;;

answer_q3 <- concept_expected_answer;;
answer_q3 => nrel_main_idtf:
    [C = <C_g, C_h, C_s, C_d, C_u>:
     C_g — целевой (concept_goal_context),
     C_h — исторический (concept_history_context),
     C_s — системный (concept_system_context),
     C_d — предметный (concept_domain_context),
     C_u — ситуационный (concept_user_situation_context)]
    (* <- lang_ru;; *);;
question_context_composition => nrel_expected_answer: answer_q3;;

// ---------------------------------------------------------------------
// Q4: Семь подмножеств отношений R.
// ---------------------------------------------------------------------

question_relation_subsets <- concept_test_question;;
question_relation_subsets => nrel_main_idtf:
    [Q4. На какие семь функциональных подмножеств разбито
     множество R семантических отношений модели M_int?]
    (* <- lang_ru;; *);;
question_relation_subsets => nrel_question_subject: concept_relation_set;;

answer_q4 <- concept_expected_answer;;
answer_q4 => nrel_main_idtf:
    [R = R_str ∪ R_goal ∪ R_ctx ∪ R_task ∪ R_exec ∪ R_ctrl ∪ R_prov,
     где R_ctrl — управляющее подмножество (доверие, согласованность,
     конфликты, доступ, надзор, верификация), а R_trust ⊑ R_ctrl
     сохранено как его семантическая часть]
    (* <- lang_ru;; *);;
question_relation_subsets => nrel_expected_answer: answer_q4;;

// ---------------------------------------------------------------------
// Q5: Компоненты Cap(s).
// ---------------------------------------------------------------------

question_capability_profile_composition <- concept_test_question;;
question_capability_profile_composition => nrel_main_idtf:
    [Q5. Какие восемь компонентов образуют профиль возможностей Cap(s)
     интеллектуальной системы?]
    (* <- lang_ru;; *);;
question_capability_profile_composition => nrel_question_subject:
    concept_capability_profile;;

answer_q5 <- concept_expected_answer;;
answer_q5 => nrel_main_idtf:
    [Cap(s) = <T_s, In_s, Out_s, Pre_s, Post_s, Q_s, K_s, L_s>]
    (* <- lang_ru;; *);;
question_capability_profile_composition => nrel_expected_answer: answer_q5;;

// ---------------------------------------------------------------------
// Q6: Компоненты вектора доверия.
// ---------------------------------------------------------------------

question_trust_vector_composition <- concept_test_question;;
question_trust_vector_composition => nrel_main_idtf:
    [Q6. Из каких четырёх компонент состоит вектор доверия T(s, τ)?]
    (* <- lang_ru;; *);;
question_trust_vector_composition => nrel_question_subject:
    concept_trust_vector;;

answer_q6 <- concept_expected_answer;;
answer_q6 => nrel_main_idtf:
    [T(s, τ) = <t_rel, t_acc, t_sec, t_tr> — надёжность, достоверность,
     безопасность, прозрачность] (* <- lang_ru;; *);;
question_trust_vector_composition => nrel_expected_answer: answer_q6;;

// ---------------------------------------------------------------------
// Q7: Семь групп множества сущностей E.
// ---------------------------------------------------------------------

question_entity_groups <- concept_test_question;;
question_entity_groups => nrel_main_idtf:
    [Q7. На какие семь групп разбито множество сущностей E
     и как на них отображаются прежние классификации базы знаний?]
    (* <- lang_ru;; *);;
question_entity_groups => nrel_question_subject: concept_entity_class_set;;

answer_q7 <- concept_expected_answer;;
answer_q7 => nrel_main_idtf:
    [E = E_subj ∪ E_goal ∪ E_part ∪ E_proc ∪ E_ctx ∪ E_result ∪ E_ctrl.
     Карта прежних классификаций: интенциональная и запросная → E_goal;
     агентная и ролевая → E_part; контекстная → E_ctx;
     процессная → E_proc; результирующая и мета-результирующая
     → E_result.] (* <- lang_ru;; *);;
question_entity_groups => nrel_expected_answer: answer_q7;;

// ---------------------------------------------------------------------
// Q8: Состояния жизненного цикла обработки запроса.
// ---------------------------------------------------------------------

question_lifecycle_states <- concept_test_question;;
question_lifecycle_states => nrel_main_idtf:
    [Q8. Какова основная последовательность состояний обработки
     запроса и какие состояния являются терминальными?]
    (* <- lang_ru;; *);;
question_lifecycle_states => nrel_question_subject: concept_mediation_state;;

answer_q8 <- concept_expected_answer;;
answer_q8 => nrel_main_idtf:
    [x_0 → x_int → x_plan → x_assign → x_exec → x_aggregate
     → x_verify → x_present.
     Терминальные: x_present (успех), x_partial (частичный результат),
     x_clar (уточнение), x_refuse (структурированный отказ),
     x_cancel (отмена). Из терминального состояния переход
     не допускается.] (* <- lang_ru;; *);;
question_lifecycle_states => nrel_expected_answer: answer_q8;;

// ---------------------------------------------------------------------
// Q9: Ресурсы восстановления и ограничения завершаемости.
// ---------------------------------------------------------------------

question_recovery_resources <- concept_test_question;;
question_recovery_resources => nrel_main_idtf:
    [Q9. Как связаны b_q, d_max, n_clar и N_ph с потенциалом Φ?]
    (* <- lang_ru;; *);;
question_recovery_resources => nrel_question_subject:
    concept_termination_potential;;

answer_q9 <- concept_expected_answer;;
answer_q9 => nrel_main_idtf:
    [b_q расходуется переназначением, d_max — перепланированием.
     Новый связанный цикл после x_clar уменьшает n_clar_rem.
     N_ph ограничивает серию служебных переходов без убывания.
     Φ(x) = <n_clar_rem, d_rem, n_pend + b_rem>: на ресурсных
     переходах строго убывает, на служебных — не возрастает.
     Терминальный исход не требует нулевого потенциала.]
    (* <- lang_ru;; *);;
question_recovery_resources => nrel_expected_answer: answer_q9;;

// ---------------------------------------------------------------------
// Q10: Различение записи аудита и записи происхождения.
// ---------------------------------------------------------------------

question_audit_vs_provenance <- concept_test_question;;
question_audit_vs_provenance => nrel_main_idtf:
    [Q10. Чем запись аудита отличается от провенансной записи
     и как они связаны?] (* <- lang_ru;; *);;
question_audit_vs_provenance => nrel_question_subject: concept_audit_record;;

answer_q10 <- concept_expected_answer;;
answer_q10 => nrel_main_idtf:
    [AuditRecord ⊓ ProvenanceRecord ⊑ ⊥. Запись аудита фиксирует
     совершённое действие (акт исполнения, отказ, переход, доступ);
     провенансная запись фиксирует происхождение сущности в терминах
     PROV-O. Схема: ProcessingFailure —has_audit_record→ AuditRecord;
     ExecutionAct —recorded_in→ AuditRecord;
     AuditRecord —has_provenance→ ProvenanceRecord;
     ProcessingResult —has_provenance→ ProvenanceRecord.]
    (* <- lang_ru;; *);;
question_audit_vs_provenance => nrel_expected_answer: answer_q10;;

// ---------------------------------------------------------------------
// Q11: Структура отказа и условие публикации итогового результата.
// ---------------------------------------------------------------------

question_failure_structure <- concept_test_question;;
question_failure_structure => nrel_main_idtf:
    [Q11. Каков вид структурированного отказа и при каком условии
     итоговый результат может быть представлен пользователю?]
    (* <- lang_ru;; *);;
question_failure_structure => nrel_question_subject:
    concept_processing_failure;;

answer_q11 <- concept_expected_answer;;
answer_q11 => nrel_main_idtf:
    [⊥ = <c, ϱ, a>: c ∈ C_fail — код причины, ϱ — рекомендация
     по восстановлению, a — запись аудита.
     Условие публикации: final(r) → verified(r) ∧ hasExplanation(r)
     ∧ ¬hasUnresolvedConflict(r). Запрещается только НЕРАЗРЕШЁННЫЙ
     конфликт; разрешённый остаётся в графе происхождения вместе
     с актом разрешения и объяснением.] (* <- lang_ru;; *);;
question_failure_structure => nrel_expected_answer: answer_q11;;

// ---------------------------------------------------------------------
// Q12: Отношения исполнения и происхождения демонстрационной
// конфигурации X_0.
// ---------------------------------------------------------------------

question_execution_relations <- concept_test_question;;
question_execution_relations => nrel_main_idtf:
    [Q12. Какими отношениями описывается исполнение подзадачи
     и получение итогового результата?] (* <- lang_ru;; *);;
question_execution_relations => nrel_question_subject: concept_execution_act;;

answer_q12 <- concept_expected_answer;;
answer_q12 => nrel_main_idtf:
    [executes(a, σ) — акт исполняет подзадачу;
     recorded_in(a, υ) — акт зафиксирован записью аудита;
     generated_by(z, a) — результат порождён актом;
     aggregates(z*, z) — итоговый агрегирует частичные;
     verifies(m, z*) — посредник верифицирует итоговый результат;
     validated_by(z*, m) — обратная фиксация в графе происхождения.]
    (* <- lang_ru;; *);;
question_execution_relations => nrel_expected_answer: answer_q12;;

// ---------------------------------------------------------------------
// Спецификация поиска подраздела по концепту (для Q1-style вопросов).
// ---------------------------------------------------------------------

spec_finding_section_for_concept
=> nrel_main_idtf:
    [Обобщённая спецификация для поиска подраздела,
     в котором определён указанный концепт]
    (* <- lang_ru;; *);;
sc_node_structure -> spec_finding_section_for_concept;;
spec_finding_section_for_concept -> rrel_key_sc_element:
    nrel_belongs_to_section;;
general_specification -> spec_finding_section_for_concept;;

general_specification
<- sc_node_class;
=> nrel_main_idtf:
    [обобщённая спецификация поиска] (* <- lang_ru;; *);;

necessary_general_specification
<- sc_node_class;
=> nrel_main_idtf:
    [необходимая обобщённая спецификация поиска] (* <- lang_ru;; *);;
necessary_general_specification <= nrel_strict_inclusion:
    general_specification;;
