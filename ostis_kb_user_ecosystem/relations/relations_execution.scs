// =====================================================================
// relations/relations_execution.scs
// Подмножество R_exec — отношения назначения, исполнения, порождения
// и интеграции результатов; включает связи возможностей и сервисов.
// =====================================================================

section_relations_execution
=> nrel_main_idtf:
    [Подраздел. Исполнительные отношения R_exec] (* <- lang_ru;; *);
    [Subsection. Execution Relations R_exec] (* <- lang_en;; *);
<- atomic_section;;

// ---------------------------------------------------------------------
// Назначение и исполнение подзадач.
// ---------------------------------------------------------------------

nrel_assigned_to
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [назначается*] (* <- lang_ru;; *);
    [assigned_to*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_subtask;
=> nrel_second_domain: concept_intelligent_system;;

