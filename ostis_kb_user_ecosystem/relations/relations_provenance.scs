// =====================================================================
// relations/relations_provenance.scs
// Подмножество R_prov — провенансные отношения, обеспечивающие
// сквозную трассируемость коллективной обработки. Совместимо с PROV-O.
// =====================================================================

section_relations_provenance
=> nrel_main_idtf:
    [Подраздел. Провенансные отношения R_prov] (* <- lang_ru;; *);
    [Subsection. Provenance Relations R_prov] (* <- lang_en;; *);
<- atomic_section;;

nrel_derived_from
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [выведено_из*] (* <- lang_ru;; *);
    [derived_from*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- transitive_relation;
<- antireflexive_relation;
=> nrel_first_domain: concept_result;
=> nrel_second_domain: concept_result;
=> nrel_second_domain: concept_user_request;;

// В формальном ядре derivedFrom: Result → Result. Допустимая область
// UserRequest — операциональное расширение для завершения цепочки
// происхождения исходным запросом, используемое существующим агентом.
nrel_caused_by
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [вызвано*] (* <- lang_ru;; *);
    [caused_by*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_processing_failure;
=> nrel_second_domain: concept_execution_act;;

nrel_based_on_knowledge
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [основано_на_знаниях*] (* <- lang_ru;; *);
    [based_on_knowledge*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_result;
=> nrel_second_domain: concept_knowledge_fragment;;

nrel_supported_by_explanation
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [подтверждается_объяснением*] (* <- lang_ru;; *);
    [supported_by_explanation*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_result;
=> nrel_second_domain: concept_explanation;;

nrel_explained_by
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [объяснено*] (* <- lang_ru;; *);
    [explained_by*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_result;
=> nrel_second_domain: concept_explanation;;

nrel_recorded_in
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [зафиксирован_записью_аудита*] (* <- lang_ru;; *);
    [recorded_in*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_execution_act;
=> nrel_second_domain: concept_audit_record;;

// generated_by относится только к ProcessingResult. IntegratedResult
// не является его подклассом и не требует отдельного ExecutionAct.
nrel_generated_by
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [порождён_актом_исполнения*] (* <- lang_ru;; *);
    [generated_by*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_processing_result;
=> nrel_second_domain: concept_execution_act;;

nrel_validated_by
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [подтверждён_посредником*] (* <- lang_ru;; *);
    [validated_by*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_integrated_result;
=> nrel_second_domain: concept_intelligent_mediator;;

nrel_has_provenance
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [имеет_провенансную_запись*] (* <- lang_ru;; *);
    [has_provenance*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_result;
=> nrel_first_domain: concept_audit_record;
=> nrel_first_domain: concept_user_model;
=> nrel_first_domain: concept_user_interaction_event;
=> nrel_first_domain: concept_user_assertion;
=> nrel_first_domain: concept_process_allocation;
=> nrel_first_domain: concept_conflict_resolution_act;
=> nrel_second_domain: concept_provenance_record;;

nrel_recorded_by_sc_agent
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [зафиксировано_sc_агентом*] (* <- lang_ru;; *);
    [recorded_by_sc_agent*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_provenance_record;
=> nrel_second_domain: concept_sc_agent;;

// ---------------------------------------------------------------------
// Цепочечное свойство трассировки.
// ---------------------------------------------------------------------

affirmation -> affirmation_derived_from_chain: ...
(*
    -> rrel_key_sc_element: nrel_derived_from;;
    => nrel_main_idtf:
        [Утв.(цепочечное свойство трассировки)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [derived_from ∘ derived_from ⊑ derived_from.
            Транзитивное замыкание отношения derived_from остаётся
            подмножеством derived_from, что обеспечивает возможность
            восстановления полного пути формирования любого результата
            от исходного запроса.] (* <- lang_ru;; *);;
    *);;
*);;

affirmation -> affirmation_verifies_inverse: ...
(*
    -> rrel_key_sc_element: nrel_verifies;;
    -> rrel_key_sc_element: nrel_validated_by;;
    => nrel_main_idtf:
        [Утв.(обратность верификации результата)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [verifies ≡ validated_by⁻¹.
            verifies(m, z) фиксирует действие посредника m над
            интегрированным результатом z и относится к R_exec и R_ctrl;
            validated_by(z, m) фиксирует тот же факт в графе
            происхождения и относится к R_prov. Оба отношения обязаны
            присутствовать у итогового результата.] (* <- lang_ru;; *);;
    *);;
*);;

affirmation -> affirmation_produces_inverse: ...
(*
    -> rrel_key_sc_element: nrel_produces;;
    -> rrel_key_sc_element: nrel_produced_by;;
    => nrel_main_idtf:
        [Утв.(обратность авторства результата)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [produces ≡ produced_by⁻¹.
            Отношения produces и produced_by взаимно обратны
            (не путать с симметричностью одного отношения): для
            любых is, r выполняется produces(is, r) ⟺ produced_by(r, is).
            sc-агенты могут использовать любое из них для навигации
            по графу провенанса в удобном направлении.]
           (* <- lang_ru;; *);;
    *);;
*);;
