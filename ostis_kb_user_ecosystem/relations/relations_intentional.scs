// =====================================================================
// relations/relations_intentional.scs
// Подмножество R_goal — интенциональные отношения, связывающие
// пользователя, цели и запросы.
// =====================================================================

section_relations_intentional
=> nrel_main_idtf:
    [Подраздел. Интенциональные отношения R_goal] (* <- lang_ru;; *);
    [Subsection. Intentional Relations R_goal] (* <- lang_en;; *);
<- atomic_section;;

nrel_formulates
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [формулирует*] (* <- lang_ru;; *);
    [formulates*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- functional_relation;
=> nrel_first_domain: concept_user;
=> nrel_second_domain: concept_user_request;;

nrel_has_goal
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [имеет_цель*] (* <- lang_ru;; *);
    [has_goal*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_user_request;
=> nrel_second_domain: concept_goal;;

