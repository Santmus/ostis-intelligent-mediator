// =====================================================================
// relations/relations_task.scs
// Подмножество R_task — отношения декомпозиции и зависимости подзадач.
// =====================================================================

section_relations_task
=> nrel_main_idtf:
    [Подраздел. Задачные отношения R_task] (* <- lang_ru;; *);
    [Subsection. Task Relations R_task] (* <- lang_en;; *);
<- atomic_section;;

nrel_decomposed_into
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [декомпозируется_на*] (* <- lang_ru;; *);
    [decomposed_into*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
=> nrel_first_domain: concept_user_request;
=> nrel_second_domain: concept_subtask;;

nrel_subtask_depends_on
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [подзадача_зависит_от*] (* <- lang_ru;; *);
    [depends_on*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- transitive_relation;
=> nrel_first_domain: concept_subtask;
=> nrel_second_domain: concept_subtask;;

nrel_subtask_of_subtask
