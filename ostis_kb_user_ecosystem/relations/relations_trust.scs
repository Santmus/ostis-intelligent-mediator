// =====================================================================
// relations/relations_trust.scs
// Подмножество R_trust — отношения доверия и согласованности /
// конфликтности результатов.
// =====================================================================

section_relations_trust
=> nrel_main_idtf:
    [Подраздел. Отношения доверия R_trust] (* <- lang_ru;; *);
    [Subsection. Trust Relations R_trust] (* <- lang_en;; *);
<- atomic_section;;

nrel_has_trust_level
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [имеет_уровень_доверия*] (* <- lang_ru;; *);
    [has_trust_level*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_intelligent_system;
=> nrel_second_domain: concept_trust_level;;

nrel_trust_for_task
<- sc_node_non_role_relation;
