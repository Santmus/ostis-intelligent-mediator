// =====================================================================
// relations/relations_trust.scs
// Подмножество R_trust — отношения доверия, согласованности
// и конфликтности результатов.
//
// R_trust ⊑ R_ctrl: с приведением к финальной модели (гл. 2) отношения
// этого файла входят в управляющее подмножество R_ctrl, состав
// которого зафиксирован в relations/relations_control.scs. Прежний
// идентификатор R_trust сохранён, чтобы не ломать навигацию и ссылки.
// =====================================================================

section_relations_trust
=> nrel_main_idtf:
    [Подраздел. Отношения доверия R_trust (часть R_ctrl)] (* <- lang_ru;; *);
    [Subsection. Trust Relations R_trust (part of R_ctrl)] (* <- lang_en;; *);
<- atomic_section;;

nrel_has_trust_level
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [имеет_уровень_доверия*] (* <- lang_ru;; *);
    [has_trust_level*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_intelligent_system;
=> nrel_second_domain: concept_trust_level;;

nrel_previous_trust_level
<- sc_node_non_role_relation;
=> nrel_main_idtf: [предыдущий_уровень_доверия*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- functional_relation;
=> nrel_first_domain: concept_trust_level;
=> nrel_second_domain: concept_trust_level;;

nrel_trust_for_task
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [доверие_по_классу_задач*] (* <- lang_ru;; *);
    [trust_for_task*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_trust_level;
=> nrel_second_domain: concept_task_type;;

nrel_conflicts_with
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [конфликтует_с*] (* <- lang_ru;; *);
    [conflicts_with*] (* <- lang_en;; *);
<- binary_relation;
<- symmetric_relation;
<- antireflexive_relation;
=> nrel_first_domain: concept_processing_result;
=> nrel_second_domain: concept_processing_result;;

nrel_consistent_with
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [согласован_с*] (* <- lang_ru;; *);
    [consistent_with*] (* <- lang_en;; *);
<- binary_relation;
<- symmetric_relation;
<- reflexive_relation;
=> nrel_first_domain: concept_processing_result;
=> nrel_second_domain: concept_processing_result;;

// Область определения — объяснение, а не интегрированный результат:
// конфликт разрешается предъявляемой процедурой и её объяснением,
// а не самим результатом. Коллективное решение как способ разрешения
// связывается с конфликтом через акт разрешения (nrel_resolved_by).
//
// Расхождение с реализацией снято 01.09.2026 (AGENTS_AUDIT.md, §6.4):
// AgentResolveByTrustWeighted
// (ostis_ps_user_ecosystem/src/agent/agent_resolve_by_trust_weighted.cpp)
// теперь создаёт concept_conflict_resolution_act, связывает его
// с конфликтом через nrel_resolved_by, устанавливает
// nrel_conflict_status = resolved и относит resolves_conflict
// к порождённому объяснению -- в соответствии с областью определения
// ниже.
nrel_resolves_conflict
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [разрешает_конфликт*] (* <- lang_ru;; *);
    [resolves_conflict*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_explanation;
=> nrel_second_domain: concept_result_conflict;;

nrel_trust_updated_by_feedback
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [доверие_обновлено_обратной_связью*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_trust_level;
=> nrel_second_domain: concept_user_feedback;;

nrel_argues_for
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [аргументирует_в_пользу*] (* <- lang_ru;; *);
    [argues_for*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_decision_argument;
=> nrel_second_domain: concept_collective_decision;;

nrel_attacks
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [атакует_аргумент*] (* <- lang_ru;; *);
    [attacks*] (* <- lang_en;; *);
<- binary_relation;
<- antireflexive_relation;
<- oriented_relation;
=> nrel_first_domain: concept_decision_argument;
=> nrel_second_domain: concept_decision_argument;;
