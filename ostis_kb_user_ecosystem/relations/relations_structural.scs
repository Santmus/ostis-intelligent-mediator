nrel_member_of
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [является_членом*] (* <- lang_ru;; *);
    [member_of*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_intelligent_system;
=> nrel_second_domain: concept_community_of_intelligent_systems;;

