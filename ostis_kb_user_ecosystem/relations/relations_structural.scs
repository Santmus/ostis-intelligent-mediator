// =====================================================================
// relations/relations_structural.scs
// Подмножество R_str — структурные и таксономические отношения.
// Включает таксономические (subdivision, inclusion, instance), а также
// композиционные (contains, part_of) и метаонтологические (defined_in,
// belongs_to_section) связи.
// =====================================================================

section_relations_structural
=> nrel_main_idtf:
    [Подраздел. Структурные отношения R_str] (* <- lang_ru;; *);
    [Subsection. Structural Relations R_str] (* <- lang_en;; *);
<- atomic_section;;

// ---------------------------------------------------------------------
// Таксономические отношения.
// ---------------------------------------------------------------------

nrel_inclusion
<- sc_node_non_role_relation;
=> nrel_main_idtf: [включение*] (* <- lang_ru;; *);
=> nrel_main_idtf: [inclusion*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- transitive_relation;;

nrel_strict_inclusion
<- sc_node_non_role_relation;
=> nrel_main_idtf: [строгое_включение*] (* <- lang_ru;; *);
=> nrel_main_idtf: [strict_inclusion*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- transitive_relation;;

nrel_subdividing
<- sc_node_non_role_relation;
=> nrel_main_idtf: [разбиение*] (* <- lang_ru;; *);
=> nrel_main_idtf: [subdividing*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;;

nrel_equivalence
<- sc_node_non_role_relation;
=> nrel_main_idtf: [эквивалентность*] (* <- lang_ru;; *);
=> nrel_main_idtf: [equivalence*] (* <- lang_en;; *);
<- binary_relation;
<- symmetric_relation;
<- reflexive_relation;
<- transitive_relation;;

nrel_disjoint_with
<- sc_node_non_role_relation;
=> nrel_main_idtf: [дизъюнктно_с*] (* <- lang_ru;; *);
=> nrel_main_idtf: [disjoint_with*] (* <- lang_en;; *);
<- binary_relation;
<- symmetric_relation;
<- antireflexive_relation;;

