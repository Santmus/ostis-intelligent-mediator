// =====================================================================
// relations/role_relations.scs
// Ролевые отношения (rrel_*) — параметры n-арных sc-конструкций,
// фиксирующих акты взаимодействия, назначения, обмена знаниями,
// контекстную композицию и коллективные решения.
// =====================================================================

section_role_relations
=> nrel_main_idtf:
    [Подраздел. Ролевые отношения] (* <- lang_ru;; *);
    [Subsection. Role Relations] (* <- lang_en;; *);
<- atomic_section;;

// ---------------------------------------------------------------------
// Базовые роли в жизненном цикле.
// ---------------------------------------------------------------------

rrel_actor
<- sc_node_role_relation;
=> nrel_main_idtf: [актор'] (* <- lang_ru;; *);
=> nrel_main_idtf: [actor'] (* <- lang_en;; *);
=> nrel_description:
    [Ролевое отношение, связывающее акт взаимодействия с его участником — сущностью, которая инициирует, выполняет или принимает действие: пользователем, интеллектуальной системой или программным агентом. Актор определяется в рамках конкретного акта и несёт ответственность за порождаемые им результаты и провенансные записи.] (* <- lang_ru;; *);
=> nrel_description:
    [Role relation denoting an entity participating in an action, process, or interaction act.] (* <- lang_en;; *);
=> nrel_first_domain: concept_interaction_act;
=> nrel_second_domain: concept_actor;;


