// ---------------------------------------------------------------------
// Роли композиции контекста C = <C_g, C_h, C_s, C_d, C_u>.
// ---------------------------------------------------------------------
// Ролевое отношение rrel_goal_context.
// Связывает экземпляр контекста взаимодействия с его целевой
// составляющей: целями пользователя, ожидаемыми результатами
// обработки, приоритетами и требованиями к качеству.
rrel_goal_context
<- sc_node_role_relation;
=> nrel_main_idtf: [целевой_подконтекст'] (* <- lang_ru;; *);
=> nrel_description:
    [Ролевое отношение, связывающее экземпляр контекста взаимодействия
     с его целевой составляющей, содержащей цели пользователя,
     ожидаемые результаты обработки, приоритеты и требования
     к качеству.] (* <- lang_ru;; *);
=> nrel_first_domain: concept_interaction_context;
=> nrel_second_domain: concept_goal_context;;
rrel_goal_context
=> nrel_used_in:
    concept_process_interpretation;
    concept_process_allocation;
    concept_context_compatibility_function;
    concept_process_integration;;
rrel_goal_context
=> nrel_supports:
    concept_context_aware_processing;
    concept_adaptive_interaction;
    concept_personalized_processing;;


rrel_history_context
<- sc_node_role_relation;
=> nrel_main_idtf: [исторический_подконтекст'] (* <- lang_ru;; *);;
