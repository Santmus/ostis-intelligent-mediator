// =====================================================================
// relations/relations_context.scs
// Подмножество R_ctx — отношения включения в контекст и его эволюции.
// =====================================================================

section_relations_context
=> nrel_main_idtf:
    [Подраздел. Контекстные отношения R_ctx] (* <- lang_ru;; *);
    [Subsection. Context Relations R_ctx] (* <- lang_en;; *);
<- atomic_section;;

nrel_has_context
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [имеет_контекст*] (* <- lang_ru;; *);
    [has_context*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_user_request;
=> nrel_second_domain: concept_interaction_context;;

