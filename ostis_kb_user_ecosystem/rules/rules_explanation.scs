// =====================================================================
// rules/rules_explanation.scs
// Множество F_rule (часть π_exp) — правила построения объяснения.
// Операционализируются sc-агентом agent_explanation_builder.
// =====================================================================

section_rules_explanation
=> nrel_main_idtf:
    [Подраздел. Правила построения объяснения (π_exp)] (* <- lang_ru;; *);
    [Subsection. Explanation Construction Rules (π_exp)] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: action_build_explanation;;

// ---------------------------------------------------------------------
// Класс действия для программной (C++) реализации структурной части
// всех четырёх правил ниже -- sc-агент AgentBuildExplanation
// (ostis_ps_user_ecosystem/src/agent/agent_build_explanation.*). Один
// агент на все правила: конкретный класс объяснения (local/global/
// contrastive/counterfactual/...) выбирает вызывающая сторона аргументом,
// как и AgentComputePiMetric для π_proc/π_dec/π_data. Агент строит
// овеществлённый concept_explanation_construction_act по шаблону
// prov_template_explanation (axioms/axioms_provenance.scs) и связывает
// explanandum с объяснением через nrel_supported_by_explanation (и
// nrel_explained_by, если explanandum -- concept_integrated_result), но
// не формирует содержательный текст объяснения и не связывает
// использованные правила/источники через nrel_prov_used -- см.
// комментарий в agent_build_explanation.hpp.
// ---------------------------------------------------------------------

action_build_explanation
<- sc_node_class;
=> nrel_main_idtf:
    [действие: построить объяснение] (* <- lang_ru;; *);
    [action: build explanation] (* <- lang_en;; *);;

rule -> rule_build_local_explanation: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(построение локального объяснения)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: concept_result(r) ∧ ¬supported_by_explanation(r, _),
            Then: создать concept_explanation_local(e),
                  supported_by_explanation(r, e); зафиксировать
                  использованные правила, источники знаний, входные
                  данные через шаблон prov_template_explanation.]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_build_global_explanation: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(построение глобального объяснения)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Для интегрированного результата ir построить
            concept_explanation_global(e_g), агрегирующее локальные
            объяснения частичных результатов; explained_by(ir, e_g).]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_build_contrastive_explanation: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(построение контрастивного объяснения)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Если пользователь запрашивает объяснение типа «почему X
            а не Y», построить concept_explanation_contrastive(e_c),
            фиксирующее различия в провенансных цепочках X и Y
            и решающие факторы.] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_build_counterfactual: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(построение контрфактического объяснения)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Сформировать минимальное изменение входных данных или
            контекста, при котором результат был бы иным; представить
            это изменение как concept_explanation_counterfactual.]
           (* <- lang_ru;; *);;
    *);;
*);;
