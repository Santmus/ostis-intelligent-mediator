// =====================================================================
// rules/rules_provenance_completion.scs
// Правила автоматического восполнения провенансной цепочки
// и контроля метрик прозрачности π = <π_proc, π_dec, π_data>.
// Активируются agent_provenance_registrar.
// =====================================================================

section_rules_provenance_completion
=> nrel_main_idtf:
    [Подраздел. Правила восполнения провенанса] (* <- lang_ru;; *);
    [Subsection. Provenance Completion Rules] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: action_compute_pi_metric;
<- rrel_key_sc_element: action_validate_provenance_chain;
<- rrel_key_sc_element: action_record_prov_entity;
<- rrel_key_sc_element: action_record_prov_activity;
<- rrel_key_sc_element: action_link_explanation_to_provenance;;

// ---------------------------------------------------------------------
// Классы действий для программной (C++) реализации правил ниже --
// sc-агенты AgentRecordProvEntity и AgentRecordProvActivity
// (ostis_ps_user_ecosystem/src/agent/agent_record_prov_entity.*,
// agent_record_prov_activity.*). "When: new ... появляется в sc-памяти"/
// "When: sc-агент выполняет процесс" не реализовано как автоматический
// триггер по событию появления узла -- ни один агент проекта не
// подписан на ScEventAfterGenerateOutgoingArc для произвольных классов
// (тот же явный action-инициируемый паттерн, что у всех остальных
// агентов модуля); вызывающая сторона инициирует регистрацию явно.
// agent_of(s_a) (PROV-агент, соответствующий sc-агенту s_a) не выведена
// формулой нигде в тексте -- AgentRecordProvActivity принимает готовый
// concept_prov_agent отдельным аргументом, а не вычисляет отображение
// sc-агент -> PROV-агент самостоятельно.
// ---------------------------------------------------------------------

action_record_prov_entity
<- sc_node_class;
=> nrel_main_idtf:
    [действие: зарегистрировать PROV Entity] (* <- lang_ru;; *);
    [action: record PROV entity] (* <- lang_en;; *);;

action_record_prov_activity
<- sc_node_class;
=> nrel_main_idtf:
    [действие: зарегистрировать PROV Activity] (* <- lang_ru;; *);
    [action: record PROV activity] (* <- lang_en;; *);;

rule -> rule_auto_record_prov_entity: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(автоматическая регистрация PROV Entity)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [When: new concept_processing_result(r) появляется в sc-памяти,
            Then: создать concept_prov_entity(e_r);
                  установить wasGeneratedBy(e_r, prov_activity_of_producer);
                  wasAttributedTo(e_r, prov_agent_of_producer);
                  has_provenance(r, record_r).] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_auto_record_prov_activity: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(автоматическая регистрация PROV Activity)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [When: sc-агент s_a выполняет процесс π_i на входе in_i,
            Then: создать concept_prov_activity(a) с
                  rrel_actor=s_a, rrel_input=in_i, rrel_timestamp=t;
                  PROV:used(a, in_i); wasAssociatedWith(a, agent_of(s_a)).]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Класс действия для программной (C++) реализации вычислимой части
// rule_compute_pi_metrics — sc-агент AgentComputePiMetric
// (ostis_ps_user_ecosystem/src/agent/agent_compute_pi_metric.*).
// Один и тот же агент вычисляет любую из трёх метрик (π_proc, π_dec,
// π_data) в зависимости от того, какую группу элементов передал
// вызывающий код; при pi < 1.0 на непустой группе агент создаёт
// concept_existence_constraint_violation (concepts/integrity.scs),
// связанный с проверяемой группой через nrel_concerns -- запуск
// rule_fill_missing_provenance по-прежнему не реализован (см.
// комментарий в agent_compute_pi_metric.hpp).
// ---------------------------------------------------------------------

action_compute_pi_metric
<- sc_node_class;
=> nrel_main_idtf:
    [действие: вычислить метрику полноты провенанса π] (* <- lang_ru;; *);
    [action: compute provenance completeness metric π] (* <- lang_en;; *);;

rule -> rule_compute_pi_metrics: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(вычисление метрик π_proc, π_dec, π_data)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Периодически и по запросу:
            π_proc = |{π ∈ Proc : ∃ provenance(π)}| / |Proc|;
            π_dec  = |{d ∈ Dec  : ∃ provenance(d)}| / |Dec|;
            π_data = |{d ∈ Data : ∃ provenance(d)}| / |Data|.
            Если π_• < 1.0 — создать concept_integrity_violation
            типа transparency_gap; запустить
            rule_fill_missing_provenance.] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_fill_missing_provenance: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(восполнение пропусков провенанса)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: ∃ x ∈ {Proc, Dec, Data}. ¬ ∃ provenance(x),
            Then: реконструировать provenance из:
                  (1) журнала событий sc-машины;
                  (2) истории изменения sc-памяти;
                  (3) timestamp-ов смежных активностей.
            Если реконструкция невозможна — пометить элемент
            как unverifiable; снижение π_• фиксируется как
            техническая характеристика модели в данном
            временном срезе.] (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Класс действия для программной (C++) реализации rule_link_explanation_to_provenance
// -- sc-агент AgentLinkExplanationToProvenance
// (ostis_ps_user_ecosystem/src/agent/agent_link_explanation_to_provenance.*).
// Читает rrel_uses_results/rrel_applies_rules с уже овеществлённого
// concept_explanation_construction_act (порождается AgentBuildExplanation,
// rules/rules_explanation.scs) и связывает их напрямую -- через
// nrel_prov_was_derived_from/nrel_prov_used/nrel_prov_was_attributed_to
// (concepts/provenance.scs) -- с переданными вызывающей стороной e/
// activity_of_e/agent_explanation_builder-как-concept_prov_agent.
// Ни e, ни activity_of_e, ни PROV-агент не создаются и не типизируются
// этим агентом -- та же практика "готовые PROV-O узлы передаются
// аргументами", что и в AgentRecordProvActivity. r_i/rule_i также не
// типизируются как concept_prov_entity (формальный домен обеих
// PROV-O связей) -- текст правила называет целью именно их, не
// производную сущность, поэтому агент связывает их как есть.
// ---------------------------------------------------------------------

action_link_explanation_to_provenance
<- sc_node_class;
=> nrel_main_idtf:
    [действие: связать объяснение с провенансом] (* <- lang_ru;; *);
    [action: link explanation to provenance] (* <- lang_en;; *);;

rule -> rule_link_explanation_to_provenance: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(связывание объяснения с провенансом)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Для каждого explanation_construction_act создать
            wasDerivedFrom(e, r_i) для всех use_results;
            PROV:used(activity_of_e, rule_i) для всех applies_rules;
            wasAttributedTo(e, agent_explanation_builder).]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Класс действия для программной (C++) реализации rule_verify_transitive_closure
// -- sc-агент AgentValidateProvenanceChain
// (ostis_ps_user_ecosystem/src/agent/agent_validate_provenance_chain.*).
// Дублирует rule_validate_provenance_chain (rules/rules_integrity_validation.scs,
// та же проверка достижимости concept_user_request по nrel_derived_from) --
// один агент закрывает оба правила, как AgentValidateIntegration закрыл
// rule_validate_integration/rule_validate_integrated_result_shape.
// Снижение π_data и запуск rule_fill_missing_provenance не реализованы --
// см. Limitations agent_validate_provenance_chain.hpp.
// ---------------------------------------------------------------------

action_validate_provenance_chain
<- sc_node_class;
=> nrel_main_idtf:
    [действие: проверить цепочку провенанса] (* <- lang_ru;; *);
    [action: validate provenance chain] (* <- lang_en;; *);;

rule -> rule_verify_transitive_closure: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(проверка транзитивного замыкания derived_from)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Для всякого integrated_result ir выполнить поиск
            transitive_closure(derived_from, ir) до достижения
            request. Если закрытие не достигает request — нарушение
            свойства прозрачности; снижение π_data; запуск
            rule_fill_missing_provenance.] (* <- lang_ru;; *);;
    *);;
*);;
