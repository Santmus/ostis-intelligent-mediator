// =====================================================================
// rules/rules_decomposition.scs
// Множество F_rule (часть π_dec) — правила декомпозиции запроса.
// Операционализируются sc-агентом agent_task_decomposer.
// =====================================================================

section_rules_decomposition
=> nrel_main_idtf:
    [Подраздел. Правила декомпозиции запроса (π_dec)] (* <- lang_ru;; *);
    [Subsection. Decomposition Rules (π_dec)] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: action_check_acyclicity;;

rule -> rule_apply_decomposition_pattern: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(применение шаблона декомпозиции)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: concept_user_request(q) ∧ has_goal(q, g) ∧ has_context(q, C)
                ∧ ¬∃σ. decomposed_into(q, σ),
            Then: выбрать шаблон p ∈ concept_task_decomposition_pattern,
                  максимизирующий sim_T(τ_q, τ_p) при удовлетворении
                  C; инстанцировать подзадачи σ_1, …, σ_n и связи
                  decomposed_into(q, σ_i), depends_on(σ_i, σ_j)
                  согласно шаблону.] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_recursive_decomposition: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(рекурсивная декомпозиция составной подзадачи)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: concept_subtask_composite(σ) ∧ ¬executable(σ),
            Then: применить rule_apply_decomposition_pattern к σ
                  рекурсивно до достижения атомарных подзадач.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Класс действия для программной (C++) реализации механической части
// правила ниже -- sc-агент AgentCheckAcyclicity
// (ostis_ps_user_ecosystem/src/agent/agent_check_acyclicity.*). DFS по
// nrel_subtask_depends_on над T(q) = {σ : decomposed_into(q, σ)}
// (concepts/tasks.scs, definition_dependency_graph); при обнаружении
// цикла создаёт concept_acyclicity_constraint_violation
// (concepts/integrity.scs, формализован вместе с этим агентом).
// "Инициировать пересмотр шаблона декомпозиции" не реализовано --
// agent_task_decomposer сам не реализован (rule_apply_decomposition_pattern/
// rule_recursive_decomposition -- PARTIAL, требуют sim_T и библиотеку
// шаблонов, не определённых в тексте, см. Implementation Backlog.md).
// ---------------------------------------------------------------------

action_check_acyclicity
<- sc_node_class;
=> nrel_main_idtf:
    [действие: проверить ацикличность графа зависимостей] (* <- lang_ru;; *);
    [action: check acyclicity of dependency graph] (* <- lang_en;; *);;

rule -> rule_check_acyclicity: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(проверка ацикличности графа зависимостей)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [После декомпозиции запустить проверку acyclic(depends_on);
            при обнаружении цикла создать concept_integrity_violation
            и инициировать пересмотр шаблона декомпозиции.]
           (* <- lang_ru;; *);;
    *);;
*);;
