// =====================================================================
// rules/rules_integrity_validation.scs
// SHACL-совместимые правила валидации (агент agent_integrity_checker).
// Каждое правило связано с экземпляром concept_shacl_shape либо
// прямым ограничением F_constr.
// =====================================================================

section_rules_integrity_validation
=> nrel_main_idtf:
    [Подраздел. Правила валидации целостности (SHACL-shapes)]
    (* <- lang_ru;; *);
    [Subsection. Integrity Validation Rules (SHACL Shapes)] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: action_validate_cardinality_constraint;;

// ---------------------------------------------------------------------
// Механическое ядро, общее для шести shape'ов ниже (кроме
// shape_provenance_chain_complete, требующего проверки транзитивного
// пути, а не подсчёта дуг): подсчитать sc-дуги заданного отношения у
// целевого элемента и сравнить со счётом [minCount, maxCount]. Каждый
// shape описывает это в прозе (nrel_sc_text_translation) по-разному
// ("property X minCount N", "property X⁻¹ minCount 1 maxCount 1",
// "property rrel_Y — minCount 1"), но не различает формально три
// встречающихся паттерна связи -- реализованы как явные маркеры режима,
// т.к. агенту неоткуда иначе узнать, что именно считать.
action_validate_cardinality_constraint <- sc_node_class;;
action_validate_cardinality_constraint => nrel_main_idtf:
    [проверить кардинальное ограничение] (* <- lang_ru;; *);;

// Паттерн "source -[non-role]-> target" (например nrel_has_provenance
// у shape_result_provenance).
concept_cardinality_check_outgoing_non_role <- sc_node_class;;
concept_cardinality_check_outgoing_non_role => nrel_main_idtf:
    [проверка: исходящее не-ролевое отношение] (* <- lang_ru;; *);;

// Паттерн "source⁻¹" (например nrel_formulates⁻¹ у
// shape_user_request_authorship: считаются пользователи, для которых
// target -- запрос).
concept_cardinality_check_incoming_non_role <- sc_node_class;;
concept_cardinality_check_incoming_non_role => nrel_main_idtf:
    [проверка: входящее не-ролевое отношение] (* <- lang_ru;; *);;

// Паттерн "source -[role]-> target" (пять rrel_*_context у
// shape_context_completeness).
concept_cardinality_check_outgoing_role <- sc_node_class;;
concept_cardinality_check_outgoing_role => nrel_main_idtf:
    [проверка: исходящее ролевое отношение] (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// Shape: каждый concept_user_request должен иметь ровно одного автора.
// ---------------------------------------------------------------------

shape_user_request_authorship <- concept_shacl_node_shape;;
shape_user_request_authorship => nrel_main_idtf:
    [SHACL NodeShape: автор запроса] (* <- lang_ru;; *);;

rule -> rule_validate_authorship_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_user_request_authorship)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [shape_user_request_authorship: targetClass concept_user_request;
            property nrel_formulates⁻¹; minCount 1; maxCount 1;
            class concept_user.
            Нарушение → concept_cardinality_constraint_violation,
            ссылка на ABox-фрагмент.] (* <- lang_ru;; *);;
    *);;
*);;
// Реализовано: action_validate_cardinality_constraint(request, nrel_formulates,
// concept_cardinality_check_incoming_non_role, 1, 1, concept_cardinality_constraint_violation, result_level).
// ostis_ps_user_ecosystem/src/agent/agent_validate_cardinality_constraint.cpp

// ---------------------------------------------------------------------
// Shape: каждый subtask имеет статус и приоритет.
// ---------------------------------------------------------------------

shape_subtask_status_priority <- concept_shacl_node_shape;;
shape_subtask_status_priority => nrel_main_idtf:
    [SHACL NodeShape: подзадача — статус и приоритет]
    (* <- lang_ru;; *);;

rule -> rule_validate_subtask_status_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_subtask_status_priority)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_subtask;
            property nrel_subtask_status — minCount 1;
            property nrel_subtask_priority — minCount 1;
            возможные значения статуса: см. composition
            concept_subtask_status.] (* <- lang_ru;; *);;
    *);;
*);;
// Реализовано двумя вызовами action_validate_cardinality_constraint
// (mode=concept_cardinality_check_outgoing_non_role, min=1, без max):
// по nrel_subtask_status и по nrel_subtask_priority отдельно.

// ---------------------------------------------------------------------
// Shape: каждый processing_result имеет provenance-запись и contextual
// привязку.
// ---------------------------------------------------------------------

shape_result_provenance <- concept_shacl_node_shape;;
shape_result_provenance => nrel_main_idtf:
    [SHACL NodeShape: результат — провенанс и контекст]
    (* <- lang_ru;; *);;

rule -> rule_validate_result_provenance_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_result_provenance)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_processing_result;
            property nrel_has_provenance — minCount 1;
            property nrel_generated_in_context — minCount 1;
            property nrel_obtained_from — minCount 1.
            Нарушение → concept_existence_constraint_violation.]
           (* <- lang_ru;; *);;
    *);;
*);;
// Реализовано тремя вызовами action_validate_cardinality_constraint
// (mode=outgoing_non_role, min=1, без max, violation_class=
// concept_existence_constraint_violation): по nrel_has_provenance,
// nrel_generated_in_context, nrel_obtained_from отдельно.

// ---------------------------------------------------------------------
// Shape: integrated_result имеет объяснение и не имеет неразрешённого
// конфликта.
// ---------------------------------------------------------------------

shape_integrated_result_complete <- concept_shacl_node_shape;;
shape_integrated_result_complete => nrel_main_idtf:
    [SHACL NodeShape: интегрированный результат — полнота]
    (* <- lang_ru;; *);;

rule -> rule_validate_integrated_result_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_integrated_result_complete)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_integrated_result;
            property nrel_explained_by — minCount 1;
            property nrel_validated_by — minCount 1;
            property nrel_has_provenance — minCount 1;
            property nrel_generated_in_context — minCount 1;
            property nrel_has_unresolved_conflict — maxCount 0.
            Запрещается только НЕРАЗРЕШЁННЫЙ конфликт: разрешённый
            остаётся связанным с результатом отношениями
            conflict_status = resolved и resolved_by. При наличии
            неразрешённого конфликта → откат к agent_conflict_detector
            → агрегация по rule_resolve_by_*.] (* <- lang_ru;; *);;
    *);;
*);;
// Реализуемо тремя вызовами action_validate_cardinality_constraint
// (mode=concept_cardinality_check_outgoing_non_role): nrel_explained_by
// min=1, nrel_validated_by min=1 и nrel_has_unresolved_conflict
// с max=0. Прежняя формулировка (¬∃c. conflicts_with) подсчётом дуг
// не выражалась, поскольку запрещала любой конфликт и требовала
// отдельного анализа concept_result_conflict; овеществление статуса
// конфликта отношением nrel_has_unresolved_conflict сводит проверку
// к подсчёту дуг, доступному существующему агенту.
// На момент правки в C++ вызывается только проверка nrel_explained_by.

// ---------------------------------------------------------------------
// Shape: каждая ИС имеет capability_profile.
// ---------------------------------------------------------------------

shape_is_capability <- concept_shacl_node_shape;;
shape_is_capability => nrel_main_idtf:
    [SHACL NodeShape: ИС — обязательный профиль] (* <- lang_ru;; *);;

rule -> rule_validate_is_capability_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_is_capability)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_intelligent_system;
            property nrel_has_capability_profile — minCount 1;
            qualifiedValueShape: класс concept_capability_profile.]
           (* <- lang_ru;; *);;
    *);;
*);;
// Частично реализовано: minCount-часть через
// action_validate_cardinality_constraint (outgoing_non_role, min=1).
// qualifiedValueShape (проверка класса цели) не реализована.

// ---------------------------------------------------------------------
// Shape: контекст содержит все 5 подконтекстов.
// ---------------------------------------------------------------------

shape_context_completeness <- concept_shacl_node_shape;;
shape_context_completeness => nrel_main_idtf:
    [SHACL NodeShape: полнота контекста взаимодействия]
    (* <- lang_ru;; *);;

rule -> rule_validate_context_completeness: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация полноты контекста)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_interaction_context;
            property rrel_goal_context — minCount 1;
            property rrel_history_context — minCount 1;
            property rrel_system_context — minCount 1;
            property rrel_domain_context — minCount 1;
            property rrel_user_situation_context — minCount 1.
            Нарушение → agent_context_updater запускает
            процедуру восполнения недостающих подконтекстов
            из истории пользователя.] (* <- lang_ru;; *);;
    *);;
*);;
// Реализовано пятью вызовами action_validate_cardinality_constraint
// (mode=concept_cardinality_check_outgoing_role, min=1, без max): по
// rrel_goal_context, rrel_history_context, rrel_system_context,
// rrel_domain_context, rrel_user_situation_context отдельно.
// Восполнение недостающих подконтекстов (agent_context_updater) не
// реализовано -- это отдельное, не сформулированное как SHACL-shape
// действие.

// ---------------------------------------------------------------------
// Shape: цепочка provenance замкнута до request.
// ---------------------------------------------------------------------

shape_provenance_chain_complete <- concept_shacl_property_shape;;
shape_provenance_chain_complete => nrel_main_idtf:
    [SHACL PropertyShape: полнота цепочки derived_from]
    (* <- lang_ru;; *);;

// Дублирует rule_verify_transitive_closure (rules/rules_provenance_completion.scs) --
// реализовано там же одним агентом AgentValidateProvenanceChain
// (action_validate_provenance_chain); снижение π_proc и эскалация
// agent_provenance_registrar не реализованы.
rule -> rule_validate_provenance_chain: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(полнота цепочки provenance)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Для всякого integrated_result ir должна существовать
            transitive_path nrel_derived_from до экземпляра
            concept_user_request. Иначе → нарушение цепочки
            трассировки; π_proc < 1.0; эскалация
            agent_provenance_registrar.] (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Shape: акт исполнения — подзадача и запись аудита.
// ---------------------------------------------------------------------

shape_execution_act_obligations <- concept_shacl_node_shape;;
shape_execution_act_obligations => nrel_main_idtf:
    [SHACL NodeShape: акт исполнения — подзадача и аудит]
    (* <- lang_ru;; *);;

rule -> rule_validate_execution_act_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_execution_act_obligations)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_execution_act;
            property nrel_executes — minCount 1; maxCount 1;
            property nrel_recorded_in — minCount 1; maxCount 1.
            Нарушение → concept_cardinality_constraint_violation:
            акт исполнения не считается совершённым, порождённый им
            результат не допускается к агрегации.] (* <- lang_ru;; *);;
    *);;
*);;
// Реализуемо двумя вызовами action_validate_cardinality_constraint
// (mode=concept_cardinality_check_outgoing_non_role, min=1, max=1):
// по nrel_executes и nrel_recorded_in отдельно.

// ---------------------------------------------------------------------
// Shape: запись аудита имеет собственную провенансную запись.
// ---------------------------------------------------------------------

shape_audit_record_provenance <- concept_shacl_node_shape;;
shape_audit_record_provenance => nrel_main_idtf:
    [SHACL NodeShape: запись аудита — провенанс] (* <- lang_ru;; *);;

rule -> rule_validate_audit_record_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_audit_record_provenance)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_audit_record;
            property nrel_has_provenance — minCount 1; maxCount 1.
            Дополнительно проверяется дизъюнктность классов:
            экземпляр concept_audit_record не должен принадлежать
            classу concept_provenance_record.] (* <- lang_ru;; *);;
    *);;
*);;
// minCount/maxCount-часть реализуема существующим вызовом
// action_validate_cardinality_constraint (outgoing_non_role, 1, 1).
// Проверка дизъюнктности классов подсчётом дуг не выражается
// и требует отдельного действия, пока не реализованного.

// ---------------------------------------------------------------------
// Shape: частичный результат порождён актом исполнения.
// ---------------------------------------------------------------------

shape_result_generated_by_act <- concept_shacl_node_shape;;
shape_result_generated_by_act => nrel_main_idtf:
    [SHACL NodeShape: результат — акт исполнения] (* <- lang_ru;; *);;

rule -> rule_validate_result_generated_by_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_result_generated_by_act)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_processing_result;
            property nrel_generated_by — minCount 1; maxCount 1.]
           (* <- lang_ru;; *);;
    *);;
*);;
// Реализуемо одним вызовом action_validate_cardinality_constraint
// (outgoing_non_role, min=1, max=1).

// ---------------------------------------------------------------------
// Shape: полнота фиксации перехода жизненного цикла.
// ---------------------------------------------------------------------

shape_state_transition_completeness <- concept_shacl_node_shape;;
shape_state_transition_completeness => nrel_main_idtf:
    [SHACL NodeShape: полнота перехода жизненного цикла]
    (* <- lang_ru;; *);;

rule -> rule_validate_state_transition_shape: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_state_transition_completeness)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_state_transition;
            property rrel_from_state — minCount 1; maxCount 1;
            property rrel_to_state — minCount 1; maxCount 1;
            property nrel_caused_by_event — minCount 1; maxCount 1;
            property nrel_uses_plan_version — minCount 1; maxCount 1.
            Нарушение означает невосстановимость маршрута обработки
            по журналу переходов (нарушение Req_15).] (* <- lang_ru;; *);;
    *);;
*);;
// Реализуемо четырьмя вызовами action_validate_cardinality_constraint:
// rrel_from_state и rrel_to_state — mode=concept_cardinality_check_outgoing_role;
// nrel_caused_by_event и nrel_uses_plan_version —
// mode=concept_cardinality_check_outgoing_non_role; для всех min=1, max=1.

// ---------------------------------------------------------------------
// Shape: линейность цепи версий плана.
// ---------------------------------------------------------------------

shape_plan_version_lineage <- concept_shacl_node_shape;;
shape_plan_version_lineage => nrel_main_idtf:
    [SHACL NodeShape: преемственность версий плана] (* <- lang_ru;; *);;

rule -> rule_validate_plan_version_lineage: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(валидация shape_plan_version_lineage)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [targetClass concept_plan_version;
            property nrel_replans — maxCount 1.
            У версии плана не более одного непосредственного
            предшественника; ацикличность цепи replans проверяется
            отдельно обходом графа, как и для nrel_derived_from.]
           (* <- lang_ru;; *);;
    *);;
*);;
// maxCount-часть реализуема вызовом action_validate_cardinality_constraint
// (outgoing_non_role, min=0, max=1). Ацикличность подсчётом дуг
// не выражается -- требует обхода, как shape_provenance_chain_complete.
