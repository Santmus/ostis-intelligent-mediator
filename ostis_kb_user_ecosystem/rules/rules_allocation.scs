// =====================================================================
// rules/rules_allocation.scs
// Правила семантической применимости, допустимости и формирования
// коалиции. Операционализируются agent_task_allocator.
// =====================================================================

section_rules_allocation
=> nrel_main_idtf:
    [Подраздел. Правила распределения подзадач (π_all)] (* <- lang_ru;; *);
    [Subsection. Subtask Allocation Rules (π_all)] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: action_handle_no_admissible_assignment;
<- rrel_key_sc_element: action_allocate_subtasks;;

rule -> rule_compute_match_function: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(вычисление функции match(σ, s | C))] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: concept_subtask(σ) ∧ concept_intelligent_system(s)
                ∧ has_capability_profile(s, Cap_s),
            Then: match(σ, s | C) = w_T·sim_T(τ_σ, T_s)
                  + w_In·sim_In(σ, In_s) + w_Out·sim_Out(σ, Out_s)
                  + w_C·ctx_compat(C, s) + w_Q·qos(Q_s, σ)
                  + w_R·trust(s, σ | C_h(s)).
                  sim_T задаётся мерой Ву—Палмера; остальные компоненты
                  и веса фиксируются по правилам верификации модели.]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_assignment_admissibility: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(допустимость назначения)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [assignable(σ, s, C) = 1 ⟺ match(σ, s | C) ≥ θ
            ∧ valid(C, L_s) = 1
            ∧ permit(view(C, s), s, C) = 1
            ∧ available(s, C) = 1.
            S_(σ,C) = {s ∈ S | assignable(σ, s, C) = 1}.
            При назначении создаётся concept_process_allocation
            с ролями rrel_subtask, rrel_assignee, rrel_context,
            rrel_assignment_time, rrel_required_confidence и
            rrel_priority.] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_coalition_optimization: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(оптимизация коалиции для запроса)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [χ* = arg max_{χ : T(q) ⇀ P(S) ∖ {∅}}
                 Σ_{σ ∈ T(q)} Σ_{s ∈ χ(σ)} match(σ, s | C)
            s.t. ∀σ ∀s ∈ χ(σ). assignable(σ, s, C) = 1,
            |χ(σ)| = k(σ), cover(χ, T(q)) = 1,
            consistent(C, χ) = 1.
            При k(σ) > 1 подзадача назначается нескольким участникам,
            поэтому nrel_assigned_to не функционально.
            При сепарабельных ограничениях покомпонентный выбор k(σ)
            наибольших match точен; при связывающих ограничениях
            жадная процедура является эвристикой.]
           (* <- lang_ru;; *);;
    *);;
*);;

// AgentAllocateSubtasks проверяет available, permit и порог match,
// после чего выбирает k(σ) кандидатов с наибольшими значениями.
// Значение match поступает из concept_match_assessment: sim_T задана
// в KB, но агент её не вычисляет; свободные компоненты суммы также
// остаются внешними по отношению к этой реализации. valid(C,L_s)
// не считается выполненным по умолчанию, а k(σ) передаётся аргументом.
action_allocate_subtasks
<- sc_node_class;
=> nrel_main_idtf:
    [действие: распределить подзадачу по допустимым исполнителям]
    (* <- lang_ru;; *);
    [action: allocate subtask to admissible executors] (* <- lang_en;; *);;

// AgentHandleNoAdmissibleAssignment принимает пустоту S_(σ,C) как
// установленный вызывающей стороной факт. Повторная декомпозиция
// этим агентом не выполняется.
action_handle_no_admissible_assignment
<- sc_node_class;
=> nrel_main_idtf:
    [действие: обработать отсутствие допустимого назначения] (* <- lang_ru;; *);
    [action: handle no admissible assignment] (* <- lang_en;; *);;

rule -> rule_handle_no_admissible_assignment: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(нет допустимого назначения)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: S_(σ,C) = ∅, то есть ∀s ∈ S.
                assignable(σ, s, C) = 0,
            Then: запустить ограниченную повторную декомпозицию σ
                  либо вернуть структурированный отказ с кодом,
                  соответствующим блокирующему условию.
                  Если 0 < |S_(σ,C)| < k(σ), применяется та же ветвь:
                  недостаток кратности не маскируется успешным назначением.]
           (* <- lang_ru;; *);;
    *);;
*);;
