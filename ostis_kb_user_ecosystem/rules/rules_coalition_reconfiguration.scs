// =====================================================================
// rules/rules_coalition_reconfiguration.scs
// Множество F_rule (часть π_rec) — компенсационные правила
// реконфигурации коалиции. Операционализируются sc-агентом
// agent_coalition_reconfigurator.
// =====================================================================

section_rules_coalition_reconfiguration
=> nrel_main_idtf:
    [Подраздел. Правила реконфигурации коалиции (π_rec)] (* <- lang_ru;; *);
    [Subsection. Coalition Reconfiguration Rules (π_rec)] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: action_exclude_from_coalition;
<- rrel_key_sc_element: action_reassign_on_resource_exhaustion;;

// ---------------------------------------------------------------------
// Правила раздельного расхода ресурсов восстановления. Переназначение
// и перепланирование — разные операции с разными ресурсами: смешение
// расхода нарушает лексикографическое убывание потенциала Φ.
// ---------------------------------------------------------------------

rule -> rule_reassign_on_executor_failure: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(переназначение при отказе исполнителя, расход b_q)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: has_processing_state(q, x) ∧ x ∈ WorkingState
                ∧ caused_by_event(t, ev) ∧ ev ∈ FailureEvent
                ∧ assigned_to(σ, s) ∧ remaining_reassignment_budget(x, b)
                ∧ b > 0,
            Then: создать concept_reassignment_event ev_r
                  с reassigns(ev_r, σ); выбрать резервного исполнителя
                  s' ∈ S_(σ,C) ∖ {s}, то есть удовлетворяющего ВСЕМ
                  четырём конъюнктам assignable(σ, s', C) = 1, с наибольшим
                  значением match(σ, s' | C) — шаг 2.5 жадной процедуры
                  гл. 2 исключает отказавшего из множества допустимых и
                  возвращается к выбору, а не понижает требование до
                  одного лишь порога; выполнить переход
                  x_exec → x_assign с uses_plan_version(t, pv),
                  где pv — ДЕЙСТВУЮЩАЯ версия плана (структура T(q)
                  не меняется); установить b := b − 1;
                  subtask_status(σ, reassigned);
                  создать запись аудита перехода и её провенанс.]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_replan_on_budget_exhaustion: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(перепланирование при исчерпании b_q, расход d_max)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: remaining_reassignment_budget(x, 0)
                ∧ remaining_replanning_depth(x, d) ∧ d > 0
                ∧ ∃σ. ¬terminal_status(σ),
            Then: создать concept_replanning_event; породить НОВУЮ
                  версию плана pv' с replans(pv', pv); выполнить
                  переход x_* → x_replan → x_plan
                  с uses_plan_version(t, pv'); установить d := d − 1;
                  бюджет b НЕ расходуется и может быть переустановлен
                  для новой структуры T(q);
                  создать запись аудита перехода и её провенанс.]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_refuse_on_resource_exhaustion: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(терминальный отказ при исчерпании ресурсов маршрута)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: remaining_reassignment_budget(x, 0)
                ∧ remaining_replanning_depth(x, 0)
                ∧ ∃σ. ¬terminal_status(σ),
            Then: сформировать структурированный отказ
                  ⊥ = <c, ϱ, a> с кодом c = No_Competence либо
                  Constraint_Violation и выполнить переход в x_refuse
                  либо, если уточнение способно снять причину и
                  n_clar_rem > 0, в x_clar. Оставаться в нетерминальном
                  состоянии запрещено. Терминальный исход допустим
                  при ненулевом n_clar_rem и не требует Φ(x) = <0,0,0>.]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_refuse_on_timeout: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(терминальный отказ по тайм-ауту)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: истёк внешний временной ресурс обработки запроса q,
            Then: выполнить переход в x_refuse с кодом c = Timeout
                  независимо от значения Φ(x) и остатков b_q и d_max.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Классы действий для программной (C++) реализации механической части
// двух правил ниже -- sc-агенты AgentExcludeFromCoalition и
// AgentReassignOnResourceExhaustion
// (ostis_ps_user_ecosystem/src/agent/agent_exclude_from_coalition.*,
// agent_reassign_on_resource_exhaustion.*). Оба -- только детерминированный
// state-transition; запуск rule_coalition_optimization (комбинаторная
// задача без алгоритма в тексте правил, см. Implementation Backlog.md)
// не реализован ни в одном из них.
// ---------------------------------------------------------------------

action_exclude_from_coalition
<- sc_node_class;
=> nrel_main_idtf:
    [действие: исключить систему из коалиции] (* <- lang_ru;; *);
    [action: exclude system from coalition] (* <- lang_en;; *);;

action_reassign_on_resource_exhaustion
<- sc_node_class;
=> nrel_main_idtf:
    [действие: переназначить подзадачи при истощении ресурса] (* <- lang_ru;; *);
    [action: reassign subtasks on resource exhaustion] (* <- lang_en;; *);;

rule -> rule_on_system_failure: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(реконфигурация при отказе системы)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: subtask_status(σ, failed) ∧ assigned_to(σ, s)
                ∧ member_of(s, K),
            Then: исключить s из коалиции K; запустить
                  rule_coalition_optimization для подзадач,
                  ранее назначенных s, с обновлённым S.]
           (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_on_resource_exhaustion: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(реконфигурация при истечении ресурсов)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [При обнаружении нарушения L_s системы s (resource_exhausted)
            установить subtask_status(σ, reassigned) для всех
            подзадач, назначенных s; инициировать
            rule_coalition_optimization.] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_on_constraint_violation: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(реконфигурация при нарушении F_constr)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [При появлении concept_integrity_violation, источником
            которого является s, понизить trust(s, τ, h)
            и инициировать пересчёт коалиции.] (* <- lang_ru;; *);;
    *);;
*);;

rule -> rule_on_context_drift: ...
(*
    <- concept_sc_rule;;
    => nrel_main_idtf:
        [Прав.(реконфигурация при дрейфе контекста)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [If: nrel_context_updated_by_event(C', e) ∧
                contradicts_context(C', C) ∧ serves_request(K, q) ∧
                has_context(q, C),
            Then: пересчитать ctx_compat для всех s ∈ K;
                  при ctx_compat(C', s) < θ_ctx исключить s
                  и переформировать коалицию.] (* <- lang_ru;; *);;
    *);;
*);;
