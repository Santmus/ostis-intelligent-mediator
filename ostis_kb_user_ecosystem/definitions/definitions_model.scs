// =====================================================================
// definitions/definitions_model.scs
// Сводный раздел определений и утверждений о модели M_int как целом.
// Навигационный хаб: дублирует определения, созданные в концептуальных
// файлах, и формирует общее оглавление для IMS.ostis-навигаторов.
// =====================================================================

section_definitions_model
=> nrel_main_idtf:
    [Подраздел. Определения и утверждения модели M_int]
    (* <- lang_ru;; *);
    [Subsection. Definitions and Affirmations of the M_int Model]
    (* <- lang_en;; *);
<- non_atomic_section;;

// ---------------------------------------------------------------------
// Главное определение: формальный кортеж модели.
// ---------------------------------------------------------------------

definition -> definition_ontological_interaction_model: ...
(*
    -> rrel_key_sc_element: concept_ontological_interaction_model;;
    => nrel_main_idtf:
        [Опр.(онтологическая модель взаимодействия M_int)]
       (* <- lang_ru;; *);;
    <= nrel_using_constants: ...
    (*
        -> concept_entity_class_set;
           concept_relation_set;
           concept_attribute_set;
           concept_formal_means_set;
           concept_axiom_set;
           concept_rule_set;
           concept_constraint_set;
           concept_provenance_template_set;;
    *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Онтологическая модель взаимодействия пользователя
            с сообществом интеллектуальных систем формально задаётся
            кортежем M_int = <E, R, A, F>, где:
            E — множество классов сущностей предметной области,
                разбитое на семь групп:
                E = E_subj ∪ E_goal ∪ E_part ∪ E_proc ∪ E_ctx
                    ∪ E_result ∪ E_ctrl;
            R — множество семантических отношений (бинарных и n-арных)
                над классами E, разбитое на семь подмножеств:
                R = R_str ∪ R_goal ∪ R_ctx ∪ R_task ∪ R_exec
                    ∪ R_ctrl ∪ R_prov,
                где R_ctrl объединяет управляющие отношения — доверие,
                согласованность, конфликты, доступ, человеческий надзор
                и проверку результата (R_trust ⊑ R_ctrl);
            A — множество атрибутов сущностей и отношений, реализуемых
                в sc-памяти как ролевые и параметрические компоненты
                sc-узлов;
            F — множество формальных средств интерпретации модели,
                F = F_ax ∪ F_rule ∪ F_constr ∪ F_prov.]
           (* <- lang_ru;; *);;
        -> [The ontological model of user interaction with a community
            of intelligent systems is formally defined as a tuple
            M_int = <E, R, A, F> where E is the set of entity classes
            (E_subj ∪ E_goal ∪ E_part ∪ E_proc ∪ E_ctx ∪ E_result
            ∪ E_ctrl), R is the set of semantic relations (R_str
            ∪ R_goal ∪ R_ctx ∪ R_task ∪ R_exec ∪ R_ctrl ∪ R_prov),
            A is the set of attributes, and F = F_ax ∪ F_rule
            ∪ F_constr ∪ F_prov is the set of formal interpretation
            means.] (* <- lang_en;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Утверждение: распределение подзадач по возможностям.
// ---------------------------------------------------------------------

affirmation -> affirmation_capability_match: ...
(*
    -> rrel_key_sc_element: nrel_assigned_to;;
    => nrel_main_idtf:
        [Утв.(распределение подзадач по возможностям)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Назначение подзадачи σ интеллектуальной системе s
            определяется двумя РАЗНЫМИ условиями, которые не следует
            смешивать.
            (1) Допустимость: assign(σ, s) = 1 ⟺ match(σ, s | C) ≥ θ
            ∧ valid(C, L_s) = 1 ∧ permit(view(C, s), s, C) = 1
            ∧ available(s, C) = 1, где
            match(σ, s | C) = w_T·sim_T + w_I·sim_I + w_O·sim_O
                            + w_C·ctx_compat + w_Q·qos_score + w_R·trust.
            Допустимость — свойство пары (σ, s), не зависящее от
            остальных кандидатов.
            (2) Выбор: из множества допустимых S_(σ,C) берутся k(σ)
            участников с наибольшими значениями match — шаг 2.3 жадной
            процедуры распределения. Максимум по кандидатам относится
            к выбору, а не к допустимости: участник может быть
            допустимым, не будучи наилучшим.
            (Прежняя редакция содержала двухконъюнктную допустимость и
            включала требование максимума в само условие назначения —
            приведено в соответствие с гл. 2 13.09.2026.)]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Определение: операционный контур посредника.
// ---------------------------------------------------------------------

definition -> definition_mediation_operational_loop: ...
(*
    -> rrel_key_sc_element: concept_mediation_state;;
    -> rrel_key_sc_element: concept_state_transition;;
    -> rrel_key_sc_element: concept_plan_version;;
    => nrel_main_idtf:
        [Опр.(операционный контур посредника)] (* <- lang_ru;; *);;
    <= nrel_using_constants: ...
    (*
        -> concept_mediation_state;
           concept_state_transition;
           concept_processing_plan;
           concept_plan_version;
           concept_execution_act;
           concept_audit_record;
           concept_provenance_record;
           concept_reassignment_budget;
           concept_replanning_depth;;
    *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Операционный контур посредника есть цепочка
            «состояние — план — исполнение — аудит — провенанс —
            верификация — терминальный исход». Переходы описываются
            функцией δ: X × E × C → X × A; каждый переход указывает
            событие-основание, действовавшую версию плана и запись
            аудита. Восстановление маршрута обеспечивается двумя
            независимыми ресурсами: бюджетом переназначений b_q,
            меняющим исполнителя при неизменной структуре задачи,
            и глубиной перепланирования d_max, меняющей саму структуру
            графа подзадач. Терминальные исходы: x_present, x_partial,
            x_clar, x_refuse и x_cancel.] (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Утверждение: прозрачность модели.
// ---------------------------------------------------------------------

affirmation -> affirmation_transparency: ...
(*
    -> rrel_key_sc_element: concept_ontological_interaction_model;;
    => nrel_main_idtf:
        [Утв.(прозрачность модели взаимодействия)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Модель удовлетворяет свойству прозрачности, если для каждого
            интегрированного результата r существует трассируемая цепочка
            экземпляров отношений {nrel_decomposed_into, nrel_assigned_to,
            nrel_produces, nrel_integrated_in, nrel_supported_by_explanation},
            восстанавливающая весь путь его формирования от исходного
            пользовательского запроса. Прозрачность измеряется тройкой
            π = <π_proc, π_dec, π_data>; целевое значение π_• = 1.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Утверждение: расширяемость модели.
// ---------------------------------------------------------------------

affirmation -> affirmation_extensibility: ...
(*
    -> rrel_key_sc_element: concept_intelligent_ecosystem;;
    => nrel_main_idtf:
        [Утв.(расширяемость модели)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Введение в семантическую память новых экземпляров классов E,
            отношений R или процессов Π не нарушает истинности уже
            установленных аксиом множества F при условии сохранения
            доменных и кодоменных ограничений соответствующих отношений
            и согласованности с foundational-уровнем модели.
            Расширяемость реализуется как пополнение базы знаний
            посредника без модификации архитектуры взаимодействия.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Утверждение: адаптивность модели.
// ---------------------------------------------------------------------

affirmation -> affirmation_adaptivity: ...
(*
    -> rrel_key_sc_element: concept_community_of_intelligent_systems;;
    => nrel_main_idtf:
        [Утв.(адаптивность модели)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Адаптивность достигается за счёт динамического формирования
            сообщества интеллектуальных систем для каждого запроса
            в зависимости от его контекста и доступных возможностей
            экосистемы. Формально процесс формирования коалиции есть
            решение оптимизационной задачи (13).]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Утверждение: соответствие SROIQ / OWL 2.
// ---------------------------------------------------------------------

affirmation -> affirmation_sroiq_compatibility: ...
(*
    -> rrel_key_sc_element: concept_axiom_set;;
    => nrel_main_idtf:
        [Утв.(совместимость с SROIQ / OWL 2)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Логические свойства отношений модели (рефлексивность,
            транзитивность, функциональность, обратимость) фиксируются
            аксиомами F_ax в дескриптивной логике SROIQ. Соответствие
            SROIQ-аксиом стандартам OWL 2 и ограничений F_constr подходу
            SHACL обеспечивает совместимость модели со стандартами
            Semantic Web и возможность использовать существующие
            OWL-резонёры как вспомогательные компоненты вывода.]
           (* <- lang_ru;; *);;
    *);;
*);;
