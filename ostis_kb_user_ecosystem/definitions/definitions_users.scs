// =====================================================================
// definitions/definitions_users.scs
// Аккумулирующий навигационный подраздел для определений пользователей
// и моделей пользователей. Не дублирует тела определений (они находятся
// в concepts/users.scs), а агрегирует ссылки на ключевые элементы.
// =====================================================================

section_definitions_users
=> nrel_main_idtf:
    [Подраздел. Определения, относящиеся к пользователям]
    (* <- lang_ru;; *);
    [Subsection. User-Related Definitions] (* <- lang_en;; *);
<- non_atomic_section;
<- rrel_key_sc_element: definition_user;
<- rrel_key_sc_element: definition_usage_context_model;
<- rrel_key_sc_element: definition_user_model;
<- rrel_key_sc_element: definition_user_domain_role;
<- rrel_key_sc_element: definition_user_interaction_history;
<- rrel_key_sc_element: definition_user_interaction_event;
<- rrel_key_sc_element: affirmation_user_model_uniqueness;
<- rrel_key_sc_element: affirmation_user_model_cold_start;
<- rrel_key_sc_element: affirmation_user_model_version_provenance;
<- rrel_key_sc_element: affirmation_user_assertion_metadata;;

// ---------------------------------------------------------------------
// Дополнительное мета-определение для агрегированного класса.
// ---------------------------------------------------------------------

definition -> definition_user_subsystem: ...
(*
    -> rrel_key_sc_element: concept_user;;
    => nrel_main_idtf:
        [Опр.(подсистема пользователей экосистемы)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Подсистема пользователей экосистемы включает M_UC и её
            компоненты M_U, M_UA, M_E, M_D; семь компонентов U(u);
            версии и provenance модели пользователя; события
            UserInteractionEvent; утверждения о пользователе и обратную
            связь. Устойчивые цели G_u отделены от цели конкретного
            намерения, а роли R_u — от ParticipantRole.]
           (* <- lang_ru;; *);;
    *);;
*);;
