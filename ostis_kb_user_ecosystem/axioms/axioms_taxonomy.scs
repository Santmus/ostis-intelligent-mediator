// =====================================================================
// axioms/axioms_taxonomy.scs
// Множество F_ax — терминологические аксиомы и таксономические
// ограничения, формализующие декларативный слой модели. Аксиомы
// записаны в форме, согласуемой с дескриптивной логикой SROIQ.
// =====================================================================

section_axioms_taxonomy
=> nrel_main_idtf:
    [Подраздел. Терминологические аксиомы F_ax] (* <- lang_ru;; *);
    [Subsection. Terminological Axioms F_ax] (* <- lang_en;; *);
<- atomic_section;;

// ---------------------------------------------------------------------
// Класс sc-аксиомы.
// ---------------------------------------------------------------------

concept_sc_axiom
<- sc_node_class;
=> nrel_main_idtf:
    [sc-аксиома (терминологическая)] (* <- lang_ru;; *);
    [terminological sc-axiom] (* <- lang_en;; *);;

// ---------------------------------------------------------------------
// Аксиомы покрытия и таксономии.
// ---------------------------------------------------------------------

axiom -> axiom_user_disjoint_from_intelligent_system: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(пользователь и ИС дизъюнктны)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [User ⊓ IntelligentSystem ⊑ ⊥.
            Класс пользователей и класс интеллектуальных систем
            дизъюнктны: один и тот же экземпляр не может одновременно
            принадлежать обоим классам.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_result_taxonomy: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(таксономия частичных и интегрированных результатов)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [ProcessingResult ⊑ Result; IntegratedResult ⊑ Result;
            ProcessingResult ⊓ IntegratedResult ⊑ ⊥.
            Частичный результат порождается актом исполнения.
            Интегрированный результат агрегирует частичные результаты
            и не требует собственного ExecutionAct.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_integrated_disjoint_from_conflict: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(интегрированный результат и конфликт дизъюнктны)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [IntegratedResult ⊓ ResultConflict ⊑ ⊥.
            Это ограничение принадлежности классам: один объект не
            является одновременно результатом и конфликтом. Оно не
            исключает связь результата с разрешённым конфликтом;
            публикации препятствует только неразрешённый конфликт.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_audit_disjoint_from_provenance: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(запись аудита и запись происхождения дизъюнктны)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [AuditRecord ⊓ ProvenanceRecord ⊑ ⊥.
            Запись аудита фиксирует совершённое действие — акт
            исполнения, отказ, переход состояния либо доступ к данным;
            провенансная запись фиксирует происхождение сущности
            в терминах PROV-O. Один и тот же экземпляр не может
            принадлежать обоим классам; связь между ними направлена:
            AuditRecord ⊑ ∃has_provenance.ProvenanceRecord.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_working_disjoint_from_terminal: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(рабочие и терминальные состояния дизъюнктны)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [WorkingState ⊓ TerminalState ⊑ ⊥ и
            WorkingState ⊔ TerminalState ≡ MediationState.
            Разбиение состояний обработки на рабочие и терминальные
            является полным и непересекающимся.] (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_execution_act_existential: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(экзистенциальные обязательства акта исполнения)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [ExecutionAct ⊑ ∃executes.Subtask ⊓ ∃recorded_in.AuditRecord;
            Result ⊑ ∃generated_in_context.InteractionContext
                ⊓ ∃has_provenance.ProvenanceRecord;
            ProcessingResult ⊑ ∃produced_by.IntelligentSystem
                ⊓ ∃generated_by.ExecutionAct;
            IntegratedResult ⊑ ∃aggregates.ProcessingResult.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_intent_has_goal: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(намерение имеет хотя бы одну цель)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Intent ⊑ (≥ 1 intent_goal.Goal).
            Каждому структурированному намерению сопоставлена не менее
            одной декларативная цель. Допустимый неоднозначный запрос
            может завершиться уточнением без построения Intent.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_is_has_capability_profile: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(ИС обладает профилем возможностей)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [IntelligentSystem ⊑ ∃has_capability_profile.CapabilityProfile.
            Каждая интеллектуальная система обладает хотя бы одним
            профилем возможностей.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_assigned_to_domain_range: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(домен/значение nrel_assigned_to)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [∃assigned_to.⊤ ⊑ Subtask ∧ ⊤ ⊑ ∀assigned_to.IntelligentSystem.
            Источник отношения nrel_assigned_to всегда подзадача;
            цель — всегда интеллектуальная система.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_acyclic_dependency: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(ацикличность графа зависимостей подзадач)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Subtask ⊓ ∃depends_on⁺.Self ⊑ ⊥.
            В графе зависимостей подзадач не должно быть циклов;
            нарушение порождает экземпляр concept_integrity_violation.]
           (* <- lang_ru;; *);;
    *);;
*);;

axiom -> axiom_explanation_disjoint_taxonomy: ...
(*
    <- concept_sc_axiom;;
    => nrel_main_idtf:
        [Акс.(дизъюнктность типов объяснений)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Local_explanation ⊓ Global_explanation ⊑ ⊥ ∧
            Local_explanation ⊓ Counterfactual_explanation ⊑ ⊥ ∧
            Local_explanation ⊓ Contrastive_explanation ⊑ ⊥
            (и аналогично для пар остальных типов из таксономии
            объяснений).] (* <- lang_ru;; *);;
    *);;
*);;
