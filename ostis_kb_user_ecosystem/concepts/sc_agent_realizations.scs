// =====================================================================
// concepts/sc_agent_realizations.scs
// Формальные объявления sc-агентов интеллектуального посредника по
// каноническому паттерну OSTIS (abstract_sc_agent /
// platform_dependent_abstract_sc_agent), подтверждённому по реальным
// образцам из ims.ostis.kb:
//   ims/ostis_tech/lib_ostis/sectn_lib_reusable_comp_kpm/reusable_sc_agents/
//   lib_c_agents/{erase_elements,search_of_all_input_arcs}/*.scs
//
// Дополняет concept_sc_agents.scs: тот файл описывает 10-12 семейств
// агентов на уровне процессов жизненного цикла (nrel_implements_process,
// nrel_realizes_mapping) -- эта секция формализует каждый из 27 уже
// реализованных C++ агентов (src/agent/*.cpp, module/trust_module.cpp)
// как конкретную platform_dependent-реализацию, видимую платформенным
// механизмам (nrel_sc_agent_key_sc_elements, nrel_primary_initiation_condition,
// nrel_initiation_condition_and_result) -- до этого файла ни один из 26
// агентов не был объявлен этим способом; они работали только через
// C++-подписку ScActionInitiatedAgent, минуя онтологический уровень.
//
// Аргументы в блоках initiation_condition/result привязаны позиционно
// через rrel_1..rrel_N -- это соответствует тому, как sc-machine
// ScAction::SetArgument(size_t idx, ...) резолвит idx в ScKeynodes::
// GetRrelIndex(idx), т.е. ровно тому же механизму, которым каждый
// агент реально читает свои аргументы через action.GetArguments<N>().
// =====================================================================

section_concept_sc_agents
<- rrel_key_sc_element: sc_agent_of_aggregate_trust;
<- rrel_key_sc_element: sc_agent_of_build_explanation;
<- rrel_key_sc_element: sc_agent_of_check_acyclicity;
<- rrel_key_sc_element: sc_agent_of_choose_modality;
<- rrel_key_sc_element: sc_agent_of_compute_pi_metric;
<- rrel_key_sc_element: sc_agent_of_detect_anomalous_request_rate;
<- rrel_key_sc_element: sc_agent_of_dispatch_ready_subtask;
<- rrel_key_sc_element: sc_agent_of_evaluate_context_aware_layout;
<- rrel_key_sc_element: sc_agent_of_evaluate_progressive_disclosure;
<- rrel_key_sc_element: sc_agent_of_exclude_from_coalition;
<- rrel_key_sc_element: sc_agent_of_handle_no_admissible_assignment;
<- rrel_key_sc_element: sc_agent_of_link_explanation_to_provenance;
<- rrel_key_sc_element: sc_agent_of_propagate_to_dependent;
<- rrel_key_sc_element: sc_agent_of_reassign_on_resource_exhaustion;
<- rrel_key_sc_element: sc_agent_of_record_prov_activity;
<- rrel_key_sc_element: sc_agent_of_record_prov_entity;
<- rrel_key_sc_element: sc_agent_of_record_state_transition;
<- rrel_key_sc_element: sc_agent_of_register_partial_result;
<- rrel_key_sc_element: sc_agent_of_resolve_by_trust_weighted;
<- rrel_key_sc_element: sc_agent_of_update_trust_accuracy;
<- rrel_key_sc_element: sc_agent_of_update_trust_reliability;
<- rrel_key_sc_element: sc_agent_of_update_trust_security;
<- rrel_key_sc_element: sc_agent_of_update_trust_transparency;
<- rrel_key_sc_element: sc_agent_of_validate_cardinality_constraint;
<- rrel_key_sc_element: sc_agent_of_validate_integration;
<- rrel_key_sc_element: sc_agent_of_validate_provenance_chain;
<- rrel_key_sc_element: sc_agent_of_validate_right_to_explanation;;

sc_agent_of_aggregate_trust
=> nrel_main_idtf:
	[Взвешенная агрегация доверия] (* <- lang_ru;; *);
<- abstract_sc_agent;
=> nrel_primary_initiation_condition: (sc_event_after_generate_outgoing_arc => action_initiated);
=> nrel_initiation_condition_and_result: (..sc_agent_of_aggregate_trust_condition => ..sc_agent_of_aggregate_trust_result);
<= nrel_sc_agent_key_sc_elements:
	{
		action_initiated;
		action;
		action_aggregate_trust
	};

=> nrel_inclusion:
	.c_realization_of_agent_of_aggregate_trust
	(*
		<- platform_dependent_abstract_sc_agent;;
		<= nrel_sc_agent_program:
		{
			[path=src/agent/agent_aggregate_trust.hpp; syntax=cpp];
			[path=src/agent/agent_aggregate_trust.cpp; syntax=cpp]
		};;

		-> sc_agent_of_aggregate_trust_active_c (* <- active_sc_agent;; *);;
	*);;

..sc_agent_of_aggregate_trust_condition
= [*
	action_aggregate_trust _-> .._action;;
	action_initiated _-> .._action;;
	action _-> .._action;;
	.._action _-> rrel_1:: .._parameter_1;;
	.._action _-> rrel_2:: .._parameter_2;;
	.._action _-> rrel_3:: .._parameter_3;;
	.._action _-> rrel_4:: .._parameter_4;;
	.._action _-> rrel_5:: .._parameter_5;;
*];;

..sc_agent_of_aggregate_trust_result
= [*
	action_aggregate_trust _-> .._action;;
	action_finished _-> .._action;;
	action _-> .._action;;
	.._action _=> nrel_result:: .._answer;;
	.._action _-> rrel_1:: .._parameter_1;;
	.._action _-> rrel_2:: .._parameter_2;;
	.._action _-> rrel_3:: .._parameter_3;;
	.._action _-> rrel_4:: .._parameter_4;;
	.._action _-> rrel_5:: .._parameter_5;;
*];;

