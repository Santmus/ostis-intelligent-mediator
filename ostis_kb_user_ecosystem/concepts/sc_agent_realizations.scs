	.._action _=> nrel_result:: .._answer;;
	.._action _-> rrel_1:: .._parameter_1;;
	.._action _-> rrel_2:: .._parameter_2;;
	.._action _-> rrel_3:: .._parameter_3;;
	.._action _-> rrel_4:: .._parameter_4;;
	.._action _-> rrel_5:: .._parameter_5;;
	.._action _-> rrel_6:: .._parameter_6;;
	.._action _-> rrel_7:: .._parameter_7;;
*];;

