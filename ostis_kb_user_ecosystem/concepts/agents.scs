// ---------------------------------------------------------------------
// Протоколы коммуникации (FIPA-ACL flavoured + расширения).
// ---------------------------------------------------------------------

concept_agent_protocol
<- sc_node_class;
=> nrel_main_idtf:
    [протокол взаимодействия агентов] (* <- lang_ru;; *);
    [agent interaction protocol] (* <- lang_en;; *);;

concept_agent_protocol <= nrel_subdividing: ...
(*
    -> concept_protocol_request_reply;
       concept_protocol_contract_net;
       concept_protocol_negotiation;
       concept_protocol_argumentation;
       concept_protocol_subscription;
       concept_protocol_blackboard;
       concept_protocol_publish_subscribe;
       concept_protocol_auction;;
*);;

concept_protocol_request_reply
<- sc_node_class;
=> nrel_main_idtf: [протокол запрос-ответ] (* <- lang_ru;; *);;
concept_protocol_contract_net
<- sc_node_class;
=> nrel_main_idtf: [протокол Contract-Net] (* <- lang_ru;; *);
=> nrel_main_idtf: [Contract-Net protocol] (* <- lang_en;; *);;
concept_protocol_negotiation
<- sc_node_class;
=> nrel_main_idtf: [протокол переговоров] (* <- lang_ru;; *);;
concept_protocol_argumentation
<- sc_node_class;
=> nrel_main_idtf: [аргументационный протокол] (* <- lang_ru;; *);
=> nrel_main_idtf: [argumentation protocol] (* <- lang_en;; *);;
concept_protocol_subscription
<- sc_node_class;
=> nrel_main_idtf: [протокол подписки] (* <- lang_ru;; *);;
concept_protocol_blackboard
<- sc_node_class;
=> nrel_main_idtf: [протокол «классной доски»] (* <- lang_ru;; *);
=> nrel_main_idtf: [blackboard protocol] (* <- lang_en;; *);;
concept_protocol_publish_subscribe
<- sc_node_class;
=> nrel_main_idtf: [протокол publish-subscribe] (* <- lang_ru;; *);;
concept_protocol_auction
<- sc_node_class;
