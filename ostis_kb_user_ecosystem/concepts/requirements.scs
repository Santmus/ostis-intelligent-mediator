requirement_Req_12
<- concept_requirement_adaptivity;
=> nrel_main_idtf: [Req_12] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Единая динамическая модель пользователя.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Профиль пользователя обновляется и используется всеми функциями
     посредника.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Ограниченная адаптивность; несоответствие целей] (* <- lang_ru;; *);;

concept_user_model => nrel_satisfies_requirement: requirement_Req_12;;

requirement_Req_13
<- concept_requirement_adaptivity;
=> nrel_main_idtf: [Req_13] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Контекстно-ориентированная адаптация.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Контекст C — явный аргумент функций интерпретации, распределения
     и агрегации.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Ограниченная адаптивность; несоответствие целей] (* <- lang_ru;; *);;

concept_interaction_context => nrel_satisfies_requirement: requirement_Req_13;;
concept_context_compatibility_function => nrel_satisfies_requirement: requirement_Req_13;;

requirement_Req_14
<- concept_requirement_adaptivity;
=> nrel_main_idtf: [Req_14] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Согласование целей пользователя и характеристик компонентов.]
    (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Определено отображение целей в метрики компонентов.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Ограниченная адаптивность; несоответствие целей] (* <- lang_ru;; *);;

concept_capability_match_function => nrel_satisfies_requirement: requirement_Req_14;;

