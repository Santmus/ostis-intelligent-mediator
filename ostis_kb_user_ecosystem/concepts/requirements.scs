=> nrel_verification_criterion:
    [Для каждого q ∈ Q_valid определена интерпретация ι(q) либо
     процедура уточнения.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Недостаточность посредников; семантическое рассогласование]
    (* <- lang_ru;; *);;

concept_intent => nrel_satisfies_requirement: requirement_Req_9;;
nrel_interprets => nrel_satisfies_requirement: requirement_Req_9;;

