// =====================================================================
// concepts/requirements.scs
// Подраздел: слой прослеживаемости требований к концептуальной модели
// взаимодействия. Формализует определение Req_i = <r_i, crit_i>
// (раздел 2.1 диссертации) и матрицу трассировки: проблема (гл. 1) →
// требование → элемент модели (Elem_i) → критерий верификации (Crit_i).
// Двадцать требований Req_1..Req_20 сгруппированы в шесть классов.
// Каждое требование связывается отношением nrel_satisfies_requirement
// с конкретными элементами онтологического ядра, реализующими его —
// операционализация двусторонней прослеживаемости, на которой
// диссертация делает методологический акцент (табл. tbl:req_matrix,
// tbl:verification), но которая ранее не была представлена в SC-коде
// отдельными sc-элементами.
// =====================================================================

section_concept_requirements
=> nrel_main_idtf:
    [Подраздел. Требования к концептуальной модели и прослеживаемость]
    (* <- lang_ru;; *);
    [Subsection. Model Requirements and Traceability] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: concept_requirement;
<- rrel_key_sc_element: concept_requirement_conceptual;
<- rrel_key_sc_element: concept_requirement_architectural;
<- rrel_key_sc_element: concept_requirement_semantic;
<- rrel_key_sc_element: concept_requirement_adaptivity;
<- rrel_key_sc_element: concept_requirement_transparency_trust;
<- rrel_key_sc_element: concept_requirement_security_privacy;;

// ---------------------------------------------------------------------
// Корневой класс требования Req_i = <r_i, crit_i>.
// ---------------------------------------------------------------------

concept_requirement
<- sc_node_class;
=> nrel_main_idtf:
    [требование к концептуальной модели] (* <- lang_ru;; *);
    [model requirement] (* <- lang_en;; *);;

definition -> definition_requirement: ...
(*
    -> rrel_key_sc_element: concept_requirement;;
    => nrel_main_idtf: [Опр.(требование к концептуальной модели)]
        (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Требование к концептуальной модели взаимодействия —
            формализованная пара Req_i = <r_i, crit_i>, где r_i —
            текстовая формулировка инвариантного свойства, которому
            должна удовлетворять модель, а crit_i — формально
            проверяемый критерий выполнения данного свойства.
            Переход от проблемы (гл. 1) к требованию выполнялся по
            схеме: проблема → негативное следствие → требуемое
            свойство модели → критерий проверки, что обеспечивает
            двустороннюю прослеживаемость между проблемами,
            требованиями и конструкциями модели.] (* <- lang_ru;; *);;
    *);;
*);;

concept_requirement <= nrel_subdividing: ...
(*
    => nrel_main_idtf: [Разбиение требований на шесть классов]
       (* <- lang_ru;; *);;
    -> concept_requirement_conceptual;
       concept_requirement_architectural;
       concept_requirement_semantic;
       concept_requirement_adaptivity;
       concept_requirement_transparency_trust;
       concept_requirement_security_privacy;;
*);;

concept_requirement_conceptual
<- sc_node_class;
=> nrel_main_idtf:
    [концептуальное требование (Req_1-Req_3)] (* <- lang_ru;; *);;
concept_requirement_architectural
<- sc_node_class;
=> nrel_main_idtf:
    [архитектурное требование (Req_4-Req_7)] (* <- lang_ru;; *);;
concept_requirement_semantic
<- sc_node_class;
=> nrel_main_idtf:
    [семантическое требование (Req_8-Req_11)] (* <- lang_ru;; *);;
concept_requirement_adaptivity
<- sc_node_class;
=> nrel_main_idtf:
    [требование адаптивности и персонализации (Req_12-Req_14)]
    (* <- lang_ru;; *);;
concept_requirement_transparency_trust
<- sc_node_class;
=> nrel_main_idtf:
    [требование прозрачности, объяснимости и доверия (Req_15-Req_18)]
    (* <- lang_ru;; *);;
concept_requirement_security_privacy
<- sc_node_class;
=> nrel_main_idtf:
    [требование безопасности и приватности (Req_19-Req_20)]
    (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// Отношения прослеживаемости. Не входят ни в одно из семи подмножеств
// R (структурные/интенциональные/контекстные/задачные/исполнительные/
// провенансные/доверия): это метамодельный слой над M_int, связывающий
// его с процессом верификации (раздел sec:verification), а не часть
// самой формальной модели предметной области.
// ---------------------------------------------------------------------

nrel_requirement_text
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [текст_требования*] (* <- lang_ru;; *);
    [requirement_text*] (* <- lang_en;; *);
<- binary_relation;
=> nrel_first_domain: concept_requirement;;

nrel_verification_criterion
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [критерий_верификации*] (* <- lang_ru;; *);
    [verification_criterion*] (* <- lang_en;; *);
<- binary_relation;
=> nrel_first_domain: concept_requirement;;

nrel_requirement_source
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [источник_требования*] (* <- lang_ru;; *);
    [requirement_source*] (* <- lang_en;; *);
<- binary_relation;
=> nrel_first_domain: concept_requirement;;

nrel_satisfies_requirement
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [реализует_требование*] (* <- lang_ru;; *);
    [satisfies_requirement*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_second_domain: concept_requirement;;

// =======================================================================
// Класс I. Концептуальные требования (Req_1-Req_3).
// =======================================================================

requirement_Req_1
<- concept_requirement_conceptual;
=> nrel_main_idtf: [Req_1] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Намеренно-ориентированное взаимодействие.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Для любого q ∈ Q_valid существует интерпретация намерения либо
     процедура уточнения.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Концептуальные (когнитивная редукция сложности)] (* <- lang_ru;; *);;

concept_process_interpretation => nrel_satisfies_requirement: requirement_Req_1;;
concept_intent => nrel_satisfies_requirement: requirement_Req_1;;
concept_recovery_clarification_request => nrel_satisfies_requirement: requirement_Req_1;;

requirement_Req_2
<- concept_requirement_conceptual;
=> nrel_main_idtf: [Req_2] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Опосредованность и единая точка координации.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Функция медиации M определена для допустимых запросов и
     возвращает результат, уточнение либо состояние отказа.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Концептуальные (когнитивная редукция сложности)] (* <- lang_ru;; *);;

concept_intelligent_mediator => nrel_satisfies_requirement: requirement_Req_2;;

requirement_Req_3
<- concept_requirement_conceptual;
=> nrel_main_idtf: [Req_3] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Целостность и согласованность результата.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Определены функция агрегации, процедура верификации и условия
     признания результата согласованным.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Концептуальные (когнитивная редукция сложности)] (* <- lang_ru;; *);;

concept_process_integration => nrel_satisfies_requirement: requirement_Req_3;;
concept_integrated_result => nrel_satisfies_requirement: requirement_Req_3;;

// =======================================================================
// Класс II. Архитектурные требования (Req_4-Req_7).
