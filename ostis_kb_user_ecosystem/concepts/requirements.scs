requirement_Req_4
<- concept_requirement_architectural;
=> nrel_main_idtf: [Req_4] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Декомпозируемость пользовательской задачи.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Существует граф подзадач T(q) в виде DAG для каждого q ∈ Q_valid.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Распределённость ответственности; фрагментация] (* <- lang_ru;; *);;

concept_process_decomposition => nrel_satisfies_requirement: requirement_Req_4;;
concept_subtask_dependency_graph => nrel_satisfies_requirement: requirement_Req_4;;

requirement_Req_5
<- concept_requirement_architectural;
=> nrel_main_idtf: [Req_5] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Семантическое распределение подзадач.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Для каждой пары (σ, s): match(σ, s | C) ≥ θ, permit = 1,
     available = 1.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Распределённость ответственности; фрагментация] (* <- lang_ru;; *);;

concept_process_allocation => nrel_satisfies_requirement: requirement_Req_5;;
concept_capability_profile => nrel_satisfies_requirement: requirement_Req_5;;
affirmation_assign_admissibility => nrel_satisfies_requirement: requirement_Req_5;;

requirement_Req_6
<- concept_requirement_architectural;
=> nrel_main_idtf: [Req_6] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Открытость и эволюционность состава сообщества.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Операция добавления интеллектуальной системы сохраняет
     ограничения F и не нарушает инварианты модели.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Распределённость ответственности; фрагментация] (* <- lang_ru;; *);;

concept_community_of_intelligent_systems => nrel_satisfies_requirement: requirement_Req_6;;
affirmation_ecosystem_dynamic_composition => nrel_satisfies_requirement: requirement_Req_6;;

requirement_Req_7
<- concept_requirement_architectural;
=> nrel_main_idtf: [Req_7] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Завершаемость обработки.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [При конечном множестве подзадач существует конечная убывающая
     мера Φ; при исчерпании ресурсов или тайм-аута достигается
     терминальное состояние.] (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Распределённость ответственности; фрагментация] (* <- lang_ru;; *);;

concept_lifecycle_process => nrel_satisfies_requirement: requirement_Req_7;;
concept_process_coalition_reconfiguration => nrel_satisfies_requirement: requirement_Req_7;;
concept_processing_failure => nrel_satisfies_requirement: requirement_Req_7;;

