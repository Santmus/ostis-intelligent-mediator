=> nrel_requirement_text:
    [Семантическая медиация.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Для каждой пары компонентов, связанных общей онтологией или
     допустимым отображением, определена функция медиации.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Недостаточность посредников; семантическое рассогласование]
    (* <- lang_ru;; *);;

concept_relation_set => nrel_satisfies_requirement: requirement_Req_10;;
concept_strategy_ontology_alignment_based => nrel_satisfies_requirement: requirement_Req_10;;

requirement_Req_11
