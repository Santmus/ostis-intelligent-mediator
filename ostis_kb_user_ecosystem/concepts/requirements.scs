<- concept_requirement_transparency_trust;
=> nrel_main_idtf: [Req_15] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Сквозная трассируемость решений.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Существует граф трассируемости для любого результата.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Прозрачность и объяснимость; распределённость ответственности]
    (* <- lang_ru;; *);;

concept_provenance_record => nrel_satisfies_requirement: requirement_Req_15;;

