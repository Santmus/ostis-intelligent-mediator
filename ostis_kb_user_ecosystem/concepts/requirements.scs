=> nrel_requirement_source:
    [Недостаточность посредников; семантическое рассогласование]
    (* <- lang_ru;; *);;

concept_ontological_interaction_model => nrel_satisfies_requirement: requirement_Req_8;;

requirement_Req_9
<- concept_requirement_semantic;
=> nrel_main_idtf: [Req_9] (* <- lang_ru;; *);
