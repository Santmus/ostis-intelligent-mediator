    (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Существует конструкция объяснения для любого значимого решения.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Прозрачность и объяснимость; распределённость ответственности]
    (* <- lang_ru;; *);;

concept_explanation => nrel_satisfies_requirement: requirement_Req_16;;
concept_process_explanation => nrel_satisfies_requirement: requirement_Req_16;;

requirement_Req_17
<- concept_requirement_transparency_trust;
=> nrel_main_idtf: [Req_17] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Многокомпонентное доверие.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [T(s, τ) — вектор из четырёх компонент со значениями от 0 до 1,
     обновляется по результатам взаимодействия.]
    (* <- lang_ru;; *);
=> nrel_requirement_source:
    [Прозрачность и объяснимость; распределённость ответственности]
    (* <- lang_ru;; *);;

concept_trust_vector => nrel_satisfies_requirement: requirement_Req_17;;
concept_trust_level => nrel_satisfies_requirement: requirement_Req_17;;

requirement_Req_18
<- concept_requirement_transparency_trust;
=> nrel_main_idtf: [Req_18] (* <- lang_ru;; *);
=> nrel_requirement_text:
    [Идентифицируемость ответственности.] (* <- lang_ru;; *);
=> nrel_verification_criterion:
    [Анализ графа трассируемости определяет ответственные компоненты.]
