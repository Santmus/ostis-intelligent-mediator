// =====================================================================
// concepts/contexts.scs
// Подраздел: пятикомпонентный контекст взаимодействия как сущность
// первого класса. C = <C_g, C_h, C_s, C_d, C_u> (eq:five_context).
// Опирается на исследования контекста и модели пользователя OSTIS.
// =====================================================================

section_concept_contexts
=> nrel_main_idtf:
    [Подраздел. Контекст взаимодействия] (* <- lang_ru;; *);
    [Subsection. Interaction Context] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: concept_interaction_context;
<- rrel_key_sc_element: concept_goal_context;
<- rrel_key_sc_element: concept_history_context;
<- rrel_key_sc_element: concept_system_context;
<- rrel_key_sc_element: concept_domain_context;
<- rrel_key_sc_element: concept_user_situation_context;
<- rrel_key_sc_element: concept_context_compatibility_function;
<- rrel_key_sc_element: concept_interaction_event;;

// ---------------------------------------------------------------------
// Класс контекста взаимодействия.
// ---------------------------------------------------------------------

concept_interaction_context
<- sc_node_class;
=> nrel_main_idtf:
    [контекст взаимодействия] (* <- lang_ru;; *);
    [interaction context] (* <- lang_en;; *);
=> nrel_idtf: [C];;

concept_interaction_context <= nrel_inclusion: concept_context_class_group;;

definition -> definition_interaction_context: ...
(*
    -> rrel_key_sc_element: concept_interaction_context;;
    => nrel_main_idtf: [Опр.(контекст взаимодействия)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Контекст взаимодействия — самостоятельная онтологическая
            сущность, представляющая собой пятикомпонентную композицию
            C = <C_g, C_h, C_s, C_d, C_u>, влияющую на интерпретацию
            запроса, выбор стратегии его обработки и состав сообщества
            интеллектуальных систем. Введение пятой составляющей C_u
            по сравнению с традиционным четырёхкомпонентным контекстом
            обеспечивает учёт операционной обстановки пользователя.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Композиция контекста по пяти ролевым подконтекстам.
// ---------------------------------------------------------------------

concept_interaction_context <= nrel_subdividing: ...
(*
    => nrel_main_idtf: [Композиция контекста C = <C_g, C_h, C_s, C_d, C_u>]
       (* <- lang_ru;; *);;
    -> concept_goal_context;
       concept_history_context;
       concept_system_context;
       concept_domain_context;
       concept_user_situation_context;;
*);;

concept_goal_context
<- sc_node_class;
=> nrel_main_idtf: [целевой контекст] (* <- lang_ru;; *);
=> nrel_main_idtf: [goal context] (* <- lang_en;; *);
=> nrel_idtf: [C_g];;

concept_history_context
<- sc_node_class;
=> nrel_main_idtf: [исторический контекст] (* <- lang_ru;; *);
=> nrel_main_idtf: [history context] (* <- lang_en;; *);
=> nrel_idtf: [C_h];;

concept_system_context
<- sc_node_class;
=> nrel_main_idtf: [системный контекст] (* <- lang_ru;; *);
=> nrel_main_idtf: [system context] (* <- lang_en;; *);
=> nrel_idtf: [C_s];;

concept_domain_context
<- sc_node_class;
=> nrel_main_idtf: [предметный контекст] (* <- lang_ru;; *);
=> nrel_main_idtf: [domain context] (* <- lang_en;; *);
=> nrel_idtf: [C_d];;

concept_user_situation_context
<- sc_node_class;
=> nrel_main_idtf: [ситуационный контекст пользователя] (* <- lang_ru;; *);
=> nrel_main_idtf: [user situation context] (* <- lang_en;; *);
=> nrel_idtf: [C_u];;

// Подклассы-флаги: конкретный экземпляр C_u, свидетельствующий об
// ограничении визуального восприятия пользователя (rules/rules_user_adaptation.scs
// -> rule_choose_modality: "rrel_user_situation_context указывает на
// ограничение визуального восприятия"). Прежде существовало только в
// прозе правила; формализовано вместе с AgentChooseModality
// (ostis_ps_user_ecosystem).
concept_visual_perception_constraint
<- sc_node_class;
=> nrel_main_idtf:
    [ситуационный контекст с ограничением визуального восприятия]
    (* <- lang_ru;; *);
    [user situation context with a visual perception constraint]
    (* <- lang_en;; *);;
concept_visual_perception_constraint <= nrel_inclusion: concept_user_situation_context;;

// Аналогично для rule_context_aware_layout: "rrel_user_situation_context
// включает индикатор «night-shift» ИЛИ low-light" -- два самостоятельных
// подкласса-флага (не один общий), поскольку правило называет их как
// два различных условия, а не одно; формализовано вместе с
// AgentEvaluateContextAwareLayout (ostis_ps_user_ecosystem).
// mobile/on-the-go (rule_choose_presentation_template) остаётся
// неформализованным -- то правило дополнительно упирается в
// неопределённую cognitive_load(u), вне рамок этой правки.
concept_night_shift_context
<- sc_node_class;
=> nrel_main_idtf:
    [ситуационный контекст ночной смены] (* <- lang_ru;; *);
    [night-shift user situation context] (* <- lang_en;; *);;
concept_night_shift_context <= nrel_inclusion: concept_user_situation_context;;

concept_low_light_context
<- sc_node_class;
=> nrel_main_idtf:
    [ситуационный контекст низкой освещённости] (* <- lang_ru;; *);
    [low-light user situation context] (* <- lang_en;; *);;
concept_low_light_context <= nrel_inclusion: concept_user_situation_context;;

// ---------------------------------------------------------------------
// Функция ctx_compat(C, s) (eq:context_compatibility).
// ---------------------------------------------------------------------

concept_context_compatibility_function
<- sc_node_class;
=> nrel_main_idtf:
    [функция контекстной совместимости ctx_compat(C, s)] (* <- lang_ru;; *);
    [context compatibility function] (* <- lang_en;; *);;

definition -> definition_ctx_compat: ...
(*
    -> rrel_key_sc_element: concept_context_compatibility_function;;
    => nrel_main_idtf: [Опр.(ctx_compat)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [ctx_compat(C, s) = Σ_{k ∈ {g,h,s,d,u}} ω_k · sim_k(C_k, p_k(s)),
            ω_k ≥ 0, Σ ω_k = 1. Здесь p_g(s) = Post_s,
            p_h(s) — статистика исполнения в реестре, p_s(s) = Stat(s),
            p_d(s) = K_s, p_u(s) — поддерживаемые модальности и каналы
            из L_s. Мера учитывает цели, историю, состояние, предметную
            онтологию и пользовательскую ситуацию.]
           (* <- lang_ru;; *);;
    *);;
*);;

affirmation -> affirmation_ctx_compat_monotonicity: ...
(*
    -> rrel_key_sc_element: concept_context_compatibility_function;;
    => nrel_main_idtf: [Утв.(монотонность контекстной совместимости)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Если C' уточняет C, то есть C_k ⊆ C'_k для каждого
            k ∈ {g,h,s,d,u}, и каждая sim_k монотонно не убывает
            по первому аргументу при фиксированном втором, то
            ctx_compat(C, s) ≤ ctx_compat(C', s). Неотрицательные
            веса сохраняют это неравенство при суммировании.
            Для непустого B примером является cov(A, B) = |A ∩ B| / |B|;
            коэффициент Жаккара условию не удовлетворяет.
            Монотонность относится только к покомпонентному уточнению,
            а не к произвольному обновлению контекста.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Динамика контекста: отношения эволюции и события.
// ---------------------------------------------------------------------

concept_interaction_event
<- sc_node_class;
=> nrel_main_idtf: [событие взаимодействия] (* <- lang_ru;; *);
=> nrel_main_idtf: [interaction event] (* <- lang_en;; *);;

concept_interaction_event <= nrel_subdividing: ...
(*
    -> concept_event_user_action;
       concept_event_system_action;
       concept_event_external_signal;
       concept_event_resource_change;
       concept_event_constraint_violation;
       concept_event_feedback_received;;
*);;

concept_event_user_action
<- sc_node_class;
=> nrel_main_idtf: [событие: действие пользователя] (* <- lang_ru;; *);;
concept_event_system_action
<- sc_node_class;
=> nrel_main_idtf: [событие: действие системы] (* <- lang_ru;; *);;
concept_event_external_signal
<- sc_node_class;
=> nrel_main_idtf: [событие: внешний сигнал] (* <- lang_ru;; *);;
concept_event_resource_change
<- sc_node_class;
=> nrel_main_idtf: [событие: изменение ресурсов] (* <- lang_ru;; *);;
concept_event_constraint_violation
<- sc_node_class;
=> nrel_main_idtf: [событие: нарушение ограничения] (* <- lang_ru;; *);;
concept_event_feedback_received
<- sc_node_class;
=> nrel_main_idtf: [событие: получение обратной связи] (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// Гипотезы и отношения эволюции контекста.
// ---------------------------------------------------------------------

concept_hypothesis
<- sc_node_class;
=> nrel_main_idtf: [гипотеза] (* <- lang_ru;; *);
=> nrel_main_idtf: [hypothesis] (* <- lang_en;; *);;

concept_context_hypothesis
<- sc_node_class;
=> nrel_main_idtf: [гипотеза о контексте] (* <- lang_ru;; *);
=> nrel_main_idtf: [context hypothesis] (* <- lang_en;; *);;
concept_context_hypothesis <= nrel_inclusion: concept_hypothesis;;

nrel_context_updated_by_event
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [обновляется_по_событию*] (* <- lang_ru;; *);
    [updated_by_event*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- functional_relation;
=> nrel_first_domain: concept_interaction_context;
=> nrel_second_domain: concept_interaction_event;;

nrel_context_inherits_from
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [наследуется_от*] (* <- lang_ru;; *);
    [inherits_from*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- transitive_relation;
=> nrel_first_domain: concept_interaction_context;
=> nrel_second_domain: concept_interaction_context;;

nrel_context_contradicts
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [контекст_противоречит*] (* <- lang_ru;; *);
    [contradicts_context*] (* <- lang_en;; *);
<- binary_relation;
<- symmetric_relation;
<- antireflexive_relation;
=> nrel_first_domain: concept_context_hypothesis;
=> nrel_second_domain: concept_context_hypothesis;;

nrel_context_dominates_over
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [контекст_доминирует_над*] (* <- lang_ru;; *);
    [dominates_over*] (* <- lang_en;; *);
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- antisymmetric_relation;
=> nrel_first_domain: concept_context_hypothesis;
=> nrel_second_domain: concept_context_hypothesis;;

// ---------------------------------------------------------------------
// Задачно-зависимые проекции и семантический контракт исполнителя.
// ---------------------------------------------------------------------

concept_user_model_projection
<- sc_node_class;
=> nrel_main_idtf:
    [задачно-зависимая проекция модели пользователя] (* <- lang_ru;; *);
    [task-dependent user model projection] (* <- lang_en;; *);;
concept_user_model_projection <= nrel_inclusion: concept_ontological_artifact;;

definition -> definition_user_model_projection: ...
(*
    -> rrel_key_sc_element: concept_user_model_projection;;
    => nrel_main_idtf: [Опр.(проекция модели пользователя)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Проекция Π_q(U_t(u)) содержит только сведения снимка U_t(u),
            необходимые для обработки конкретного запроса q. Она не
            заменяет UserModel и не копирует полные I_u, H_u или S_u,
            если достаточно ограниченного набора компонентов.]
           (* <- lang_ru;; *);;
    *);;
*);;

concept_context_projection
<- sc_node_class;
=> nrel_main_idtf:
    [разрешённая проекция контекста для участника] (* <- lang_ru;; *);
    [permitted participant context projection] (* <- lang_en;; *);;
concept_context_projection <= nrel_inclusion: concept_ontological_artifact;;

definition -> definition_context_projection: ...
(*
    -> rrel_key_sc_element: concept_context_projection;;
    => nrel_main_idtf: [Опр.(проекция контекста)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [view(C, s) — минимально необходимая проекция контекста C,
            допустимая для передачи участнику s. Передача разрешена
            только при permit(view(C, s), s, C) = 1. Пользовательская
            часть проекции строится из Π_q(U_t(u)).]
           (* <- lang_ru;; *);;
    *);;
*);;

concept_semantic_contract
<- sc_node_class;
=> nrel_main_idtf:
    [семантический контракт исполнителя] (* <- lang_ru;; *);
    [executor semantic contract] (* <- lang_en;; *);;
concept_semantic_contract <= nrel_inclusion: concept_ontological_artifact;;

definition -> definition_semantic_contract: ...
(*
    -> rrel_key_sc_element: concept_semantic_contract;;
    => nrel_main_idtf: [Опр.(семантический контракт исполнителя)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Семантический контракт связывает подзадачу, исполнителя,
            политику доступа и разрешённую проекцию view(C, s). Он может
            включать только данные, необходимые для назначенной подзадачи.
            Полная UserModel остаётся в защищённой области персонального
            ассистента или посредника.] (* <- lang_ru;; *);;
    *);;
*);;

affirmation -> affirmation_context_view_minimization: ...
(*
    -> rrel_key_sc_element: concept_context_projection;;
    => nrel_main_idtf: [Утв.(минимизация проекции контекста)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Передача view(C, s) участнику s допускается только при
            permit(view(C, s), s, C) = 1. Семантический контракт не
            может содержать полную модель пользователя вместо проекции.
            Общая логическая семантическая память не означает доступ
            всех участников к полному профилю.] (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Ограничение целостности контекста.
// ---------------------------------------------------------------------

affirmation -> affirmation_context_completeness: ...
(*
    -> rrel_key_sc_element: concept_interaction_context;;
    => nrel_main_idtf:
        [Утв.(полнота контекста взаимодействия)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Для всякого экземпляра C класса concept_interaction_context
            должны быть заданы все пять подконтекстов посредством
            ролевых отношений rrel_goal_context, rrel_history_context,
            rrel_system_context, rrel_domain_context,
            rrel_user_situation_context. Отсутствие хотя бы одного
            из них квалифицирует контекст как неполный и предотвращает
            запуск agent_task_allocator.] (* <- lang_ru;; *);;
    *);;
*);;
