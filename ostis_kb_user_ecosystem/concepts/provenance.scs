// =====================================================================
// concepts/provenance.scs
// Подраздел: провенансные классы и шаблоны F_prov, обеспечивающие
// сквозную трассируемость коллективной обработки. Согласовано с
// W3C PROV-O [24].
// =====================================================================

section_concept_provenance
=> nrel_main_idtf:
    [Подраздел. Провенансная подсистема] (* <- lang_ru;; *);
    [Subsection. Provenance Subsystem] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: concept_provenance_record;
<- rrel_key_sc_element: concept_prov_entity;
<- rrel_key_sc_element: concept_prov_activity;
<- rrel_key_sc_element: concept_prov_agent;
<- rrel_key_sc_element: concept_provenance_template;;

// ---------------------------------------------------------------------
// Корневой класс провенансной записи.
// ---------------------------------------------------------------------

concept_provenance_record
<- sc_node_class;
=> nrel_main_idtf:
    [провенансная запись] (* <- lang_ru;; *);
    [provenance record] (* <- lang_en;; *);;

definition -> definition_provenance_record: ...
(*
    -> rrel_key_sc_element: concept_provenance_record;;
    => nrel_main_idtf: [Опр.(провенансная запись)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Провенансная запись — sc-структура, фиксирующая обстоятельства
            происхождения сущности (Entity), деятельности (Activity)
            и агента (Agent) в духе W3C PROV-O. Совокупность провенансных
            записей образует граф трассировки коллективной обработки.]
           (* <- lang_ru;; *);;
    *);;
*);;

concept_provenance_record <= nrel_subdividing: ...
(*
    => nrel_main_idtf:
        [PROV-O триада: Entity, Activity, Agent] (* <- lang_ru;; *);;
    -> concept_prov_entity;
       concept_prov_activity;
       concept_prov_agent;;
*);;

concept_prov_entity
<- sc_node_class;
=> nrel_main_idtf: [provenance-entity] (* <- lang_ru;; *);
=> nrel_main_idtf: [PROV Entity] (* <- lang_en;; *);;

concept_prov_activity
<- sc_node_class;
=> nrel_main_idtf: [provenance-activity] (* <- lang_ru;; *);
=> nrel_main_idtf: [PROV Activity] (* <- lang_en;; *);;

concept_prov_agent
<- sc_node_class;
=> nrel_main_idtf: [provenance-agent] (* <- lang_ru;; *);
=> nrel_main_idtf: [PROV Agent] (* <- lang_en;; *);;

// ---------------------------------------------------------------------
// PROV-O отношения (адаптированные под SC-код).
// ---------------------------------------------------------------------

nrel_prov_was_derived_from
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [PROV:wasDerivedFrom*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_prov_entity;
=> nrel_second_domain: concept_prov_entity;;

nrel_prov_was_generated_by
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [PROV:wasGeneratedBy*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_prov_entity;
=> nrel_second_domain: concept_prov_activity;;

nrel_prov_was_associated_with
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [PROV:wasAssociatedWith*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_prov_activity;
=> nrel_second_domain: concept_prov_agent;;

nrel_prov_used
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [PROV:used*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_prov_activity;
=> nrel_second_domain: concept_prov_entity;;

nrel_prov_was_attributed_to
<- sc_node_non_role_relation;
=> nrel_main_idtf:
    [PROV:wasAttributedTo*] (* <- lang_ru;; *);
<- binary_relation;
<- oriented_relation;
=> nrel_first_domain: concept_prov_entity;
=> nrel_second_domain: concept_prov_agent;;

// ---------------------------------------------------------------------
// Шаблоны фиксации провенанса F_prov.
// ---------------------------------------------------------------------

concept_provenance_template
<- sc_node_class;
=> nrel_main_idtf:
    [шаблон фиксации провенанса] (* <- lang_ru;; *);
    [provenance template] (* <- lang_en;; *);;

concept_provenance_template <= nrel_subdividing: ...
(*
    -> concept_template_request_provenance;
       concept_template_subtask_provenance;
       concept_template_result_provenance;
       concept_template_integration_provenance;
       concept_template_explanation_provenance;
       concept_template_decision_provenance;;
*);;

concept_template_request_provenance
<- sc_node_class;
=> nrel_main_idtf: [шаблон провенанса запроса] (* <- lang_ru;; *);;
concept_template_subtask_provenance
<- sc_node_class;
=> nrel_main_idtf: [шаблон провенанса подзадачи] (* <- lang_ru;; *);;
concept_template_result_provenance
<- sc_node_class;
=> nrel_main_idtf: [шаблон провенанса результата] (* <- lang_ru;; *);;
concept_template_integration_provenance
<- sc_node_class;
=> nrel_main_idtf: [шаблон провенанса интеграции] (* <- lang_ru;; *);;
concept_template_explanation_provenance
<- sc_node_class;
=> nrel_main_idtf: [шаблон провенанса объяснения] (* <- lang_ru;; *);;
concept_template_decision_provenance
<- sc_node_class;
=> nrel_main_idtf: [шаблон провенанса решения] (* <- lang_ru;; *);;
