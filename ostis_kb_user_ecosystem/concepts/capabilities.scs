// =====================================================================
// concepts/capabilities.scs
// Подраздел: онтология возможностей интеллектуальных систем и сервисов.
// Профиль возможностей системы s задаётся кортежем
// Cap(s) = <T_s, In_s, Out_s, Pre_s, Post_s, Q_s, K_s, L_s>
// (eq:capability_profile).
// =====================================================================

section_concept_capabilities
=> nrel_main_idtf:
    [Подраздел. Онтология возможностей интеллектуальных систем]
    (* <- lang_ru;; *);
    [Subsection. Capability Ontology of Intelligent Systems]
    (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: concept_capability_profile;
<- rrel_key_sc_element: concept_task_type;
<- rrel_key_sc_element: concept_input_signature;
<- rrel_key_sc_element: concept_output_signature;
<- rrel_key_sc_element: concept_precondition;
<- rrel_key_sc_element: concept_postcondition;
<- rrel_key_sc_element: concept_qos_descriptor;
<- rrel_key_sc_element: concept_knowledge_dependency;
<- rrel_key_sc_element: concept_resource_constraint;
<- rrel_key_sc_element: concept_capability_match_function;
<- rrel_key_sc_element: concept_match_assessment;;

// ---------------------------------------------------------------------
// Корневой класс профиля возможностей.
// ---------------------------------------------------------------------

concept_capability_profile
<- sc_node_class;
=> nrel_main_idtf:
    [профиль возможностей интеллектуальной системы] (* <- lang_ru;; *);
    [capability profile] (* <- lang_en;; *);
=> nrel_idtf: [Cap(s)];;

concept_capability_profile <= nrel_inclusion: concept_ontological_artifact;;

definition -> definition_capability_profile: ...
(*
    -> rrel_key_sc_element: concept_capability_profile;;
    => nrel_main_idtf: [Опр.(профиль возможностей)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Профиль возможностей Cap(s) = <T_s, In_s, Out_s, Pre_s, Post_s,
            Q_s, K_s, L_s> — формализованное онтологическое описание
            компетенций интеллектуальной системы s, где T_s — множество
            классов задач; In_s, Out_s — типизованные сигнатуры входов
            и выходов; Pre_s, Post_s — пред- и постусловия; Q_s — вектор
            показателей качества; K_s — зависимости от источников знаний;
            L_s — ресурсные, временные и контекстные ограничения.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Композиция профиля по 8 ролевым компонентам кортежа.
// ---------------------------------------------------------------------

concept_capability_profile <= nrel_subdividing: ...
(*
    => nrel_main_idtf:
        [Композиция Cap(s) = <T_s, In_s, Out_s, Pre_s, Post_s, Q_s, K_s, L_s>]
       (* <- lang_ru;; *);;
    -> concept_task_type;
       concept_input_signature;
       concept_output_signature;
       concept_precondition;
       concept_postcondition;
       concept_qos_descriptor;
       concept_knowledge_dependency;
       concept_resource_constraint;;
*);;

