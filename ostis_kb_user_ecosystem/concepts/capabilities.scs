    [ограничение по местоположению данных] (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// Функция семантической применимости match(σ, s) (формула 11).
// ---------------------------------------------------------------------

concept_capability_match_function
<- sc_node_class;
=> nrel_main_idtf:
    [функция семантической применимости match(σ, s)] (* <- lang_ru;; *);
    [capability match function] (* <- lang_en;; *);;

definition -> definition_capability_match: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf:
        [Опр.(функция семантической применимости)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [match(σ, s) = w_T·sim_T(τ_σ, T_s) + w_I·sim_I(In_σ, In_s)
            + w_O·sim_O(Out_σ, Out_s) + w_C·ctx_compat(C, s)
            + w_Q·qos_score(s, τ_σ) + w_R·trust(s, τ_σ, h),
            Σ w_k = 1.
            sim_T — мера принадлежности типа подзадачи классам T_s;
            sim_I, sim_O — меры совместимости сигнатур;
            ctx_compat — контекстная совместимость;
            qos_score — нормализованная свёртка вектора Q_s;
            trust(s, τ, h) — скалярная оценка доверия (см. 3.H).]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Правило допустимости назначения (формула 12).
// ---------------------------------------------------------------------

affirmation -> affirmation_assign_admissibility: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf:
        [Утв.(допустимость назначения подзадачи)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [assign(σ, s) = 1 ⟺ match(σ, s | C) ≥ θ ∧ valid(C, L_s) = 1
            ∧ permit(view(C, s), s, C) = 1 ∧ available(s, C) = 1.
            Назначение подзадачи σ системе s допустимо тогда и только
            тогда, когда: значение функции применимости не ниже порога θ;
            контекст C не нарушает ресурсных ограничений L_s; передача
            участнику s минимально необходимой проекции контекста
            view(C, s) разрешена политикой доступа; участник s доступен
            в контексте C. Даже высокий match(σ, s | C) не разрешает
            назначение при недоступности участника, несовместимости
            ограничений или запрете передачи данных (гл. 2,
            формула допустимости назначения, ред. part2.tex; ранее в
            этой формуле недоставало условий permit и available —
            актуализировано вместе с ревизией главы 2 от 24.08.2026).]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Задача формирования коалиции (формула 13).
// ---------------------------------------------------------------------

affirmation -> affirmation_coalition_optimization: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf:
        [Утв.(задача формирования коалиции)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Формирование коалиции есть решение оптимизационной задачи
            max Σ_{σ ∈ T(q)} match(σ, χ(σ))
            s.t. coverage(χ, T(q)) ∧ consistent(C, χ),
            где χ : T(q) → S — функция назначения подзадач,
            T(q) — декомпозиция запроса q. Решение находится агентом
            agent_task_allocator.] (* <- lang_ru;; *);;
    *);;
*);;
