// ---------------------------------------------------------------------
// Семантическая применимость match и таксономическое сходство sim_T.
// ---------------------------------------------------------------------

concept_capability_match_function
<- sc_node_class;
=> nrel_main_idtf:
    [функция семантической применимости match(σ, s | C)] (* <- lang_ru;; *);
    [capability match function] (* <- lang_en;; *);;

definition -> definition_capability_match: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf:
        [Опр.(функция семантической применимости)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [match(σ, s | C) = w_T·sim_T(τ_σ, T_s)
            + w_In·sim_In(σ, In_s) + w_Out·sim_Out(σ, Out_s)
            + w_C·ctx_compat(C, s) + w_Q·qos(Q_s, σ)
            + w_R·trust(s, σ | C_h(s)), где w_k ≥ 0 и Σw_k = 1.
            trust(s, σ | C_h(s)) = Σ_k λ_k·t_k, λ_k ≥ 0, Σλ_k = 1.
            C_h(s) содержит историю взаимодействий именно с участником s,
            а не общую историю пользователя H_u. Компоненты sim_In,
            sim_Out, qos и веса относятся к свободным параметрам модели.]
           (* <- lang_ru;; *);;
    *);;
*);;

concept_task_type_similarity_function
<- sc_node_class;
=> nrel_main_idtf:
    [функция таксономического сходства sim_T] (* <- lang_ru;; *);
    [task type similarity function] (* <- lang_en;; *);;

definition -> definition_task_type_similarity: ...
(*
    -> rrel_key_sc_element: concept_task_type_similarity_function;;
    => nrel_main_idtf: [Опр.(мера Ву—Палмера для типов задач)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [sim_T(τ_σ, T_s) = max_{τ_s ∈ T_s}
            2·depth(lcs(τ_σ, τ_s)) / (depth(τ_σ) + depth(τ_s)),
            где lcs — ближайший общий надкласс в таксономии C,
            а depth — глубина класса от корня. Мера равна 1 при
            совпадении типов; максимум по T_s означает, что достаточно
            одной подходящей компетенции участника.]
           (* <- lang_ru;; *);;
    *);;
*);;

// Оценка пары реифицируется, поскольку match не является свойством
// отдельной подзадачи или отдельного участника.
concept_match_assessment
<- sc_node_class;
=> nrel_main_idtf:
    [оценка семантической применимости пары (σ, s)] (* <- lang_ru;; *);
    [match assessment of a (subtask, system) pair] (* <- lang_en;; *);;
concept_match_assessment <= nrel_inclusion: concept_ontological_artifact;;

definition -> definition_match_assessment: ...
(*
    -> rrel_key_sc_element: concept_match_assessment;;
    => nrel_main_idtf:
        [Опр.(оценка применимости пары)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Оценка применимости — реифицированная тройка
            ⟨σ, s, match(σ, s | C)⟩ с ролями rrel_subtask и
            rrel_assignee и связью nrel_match_value. Оценка относится
            к конкретным контексту и весам. База хранит значение как
            факт с основанием: программное вычисление всей взвешенной
            суммы без задания свободных компонент не постулируется.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Допустимость и множество допустимых исполнителей.
// ---------------------------------------------------------------------

affirmation -> affirmation_assign_admissibility: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf:
        [Утв.(допустимость назначения подзадачи)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [assignable(σ, s, C) = 1 ⟺ match(σ, s | C) ≥ θ
            ∧ valid(C, L_s) = 1
            ∧ permit(view(C, s), s, C) = 1
            ∧ available(s, C) = 1.
            S_(σ,C) = {s ∈ S | assignable(σ, s, C) = 1}.
            Высокий match не компенсирует нарушение ограничений,
            запрет передачи проекции или недоступность участника.]
           (* <- lang_ru;; *);;
    *);;
*);;

// ---------------------------------------------------------------------
// Формирование коалиции и условия применимости жадной процедуры.
// ---------------------------------------------------------------------

affirmation -> affirmation_coalition_optimization: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf:
        [Утв.(задача формирования коалиции)] (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [max_χ Σ_{σ ∈ T(q)} Σ_{s ∈ χ(σ)} match(σ, s | C)
            при ∀σ ∀s ∈ χ(σ). assignable(σ, s, C) = 1,
            |χ(σ)| = k(σ), cover(χ, T(q)) = 1,
            consistent(C, χ) = 1, где
            χ : T(q) ⇀ P(S) ∖ {∅}. Кратность k(σ) фиксируется типом
            маршрута до оптимизации. Если S_(σ,C) = ∅, посредник
            возвращает отказ, уточнение либо перепланирование,
            но не выдаёт отсутствие назначения за успех.]
           (* <- lang_ru;; *);;
    *);;
*);;

affirmation -> affirmation_greedy_allocation_conditions: ...
(*
    -> rrel_key_sc_element: concept_capability_match_function;;
    => nrel_main_idtf: [Утв.(условия точности жадного распределения)]
       (* <- lang_ru;; *);;
    <= nrel_sc_text_translation: ...
    (*
        -> [Подзадачи обрабатываются в топологическом порядке DAG.
            Для каждой σ формируется S_(σ,C); если его мощность меньше
            k(σ), выполняется ограниченное перепланирование либо отказ.
            При сепарабельных ограничениях выбор k(σ) участников с
            наибольшими match даёт точное решение задачи коалиции.
            При связывающих ограничениях задача не сепарабельна,
            процедура является эвристикой без константной гарантии
            качества. Переназначение расходует b_q, перепланирование —
            d_max.] (* <- lang_ru;; *);;
    *);;
*);;
