concept_task_type_classification
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: классификация] (* <- lang_ru;; *);;
concept_task_type_regression
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: регрессия] (* <- lang_ru;; *);;
concept_task_type_segmentation
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: сегментация] (* <- lang_ru;; *);;
concept_task_type_planning
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: планирование] (* <- lang_ru;; *);;
concept_task_type_optimization
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: оптимизация] (* <- lang_ru;; *);;
concept_task_type_recommendation
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: рекомендация] (* <- lang_ru;; *);;
concept_task_type_diagnosis
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: диагностика] (* <- lang_ru;; *);;
concept_task_type_explanation
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: объяснение] (* <- lang_ru;; *);;
concept_task_type_estimation
<- sc_node_class;
=> nrel_main_idtf: [тип задачи: оценка] (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// Сигнатуры входов и выходов In_s, Out_s.
// ---------------------------------------------------------------------

concept_input_signature
<- sc_node_class;
=> nrel_main_idtf: [сигнатура входных данных] (* <- lang_ru;; *);
=> nrel_main_idtf: [input signature] (* <- lang_en;; *);
=> nrel_idtf: [In_s];;

concept_output_signature
<- sc_node_class;
=> nrel_main_idtf: [сигнатура выходных данных] (* <- lang_ru;; *);
=> nrel_main_idtf: [output signature] (* <- lang_en;; *);
=> nrel_idtf: [Out_s];;

// ---------------------------------------------------------------------
// Пред- и постусловия Pre_s, Post_s.
// ---------------------------------------------------------------------

concept_precondition
<- sc_node_class;
=> nrel_main_idtf: [предусловие] (* <- lang_ru;; *);
=> nrel_main_idtf: [precondition] (* <- lang_en;; *);
=> nrel_idtf: [Pre_s];;

concept_postcondition
<- sc_node_class;
=> nrel_main_idtf: [постусловие] (* <- lang_ru;; *);
=> nrel_main_idtf: [postcondition] (* <- lang_en;; *);
=> nrel_idtf: [Post_s];;

// ---------------------------------------------------------------------
// Вектор показателей качества Q_s.
// ---------------------------------------------------------------------

concept_qos_descriptor
<- sc_node_class;
=> nrel_main_idtf:
    [показатели качества обработки] (* <- lang_ru;; *);
    [quality of service descriptor] (* <- lang_en;; *);
=> nrel_idtf: [Q_s];;

concept_qos_descriptor <= nrel_subdividing: ...
(*
    => nrel_main_idtf: [Размерности Q_s = (accuracy, latency, cost,
                                            energy, explainability)]
       (* <- lang_ru;; *);;
    -> concept_qos_accuracy;
       concept_qos_latency;
       concept_qos_cost;
       concept_qos_energy_consumption;
       concept_qos_explainability;
       concept_qos_robustness;
       concept_qos_privacy;;
*);;

concept_qos_accuracy
<- sc_node_class;
=> nrel_main_idtf: [показатель точности] (* <- lang_ru;; *);;
concept_qos_latency
<- sc_node_class;
=> nrel_main_idtf: [показатель латентности] (* <- lang_ru;; *);;
concept_qos_cost
<- sc_node_class;
=> nrel_main_idtf: [показатель стоимости] (* <- lang_ru;; *);;
concept_qos_energy_consumption
<- sc_node_class;
=> nrel_main_idtf: [показатель энергопотребления] (* <- lang_ru;; *);;
concept_qos_explainability
