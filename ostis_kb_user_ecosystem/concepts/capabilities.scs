concept_qos_privacy
<- sc_node_class;
=> nrel_main_idtf: [показатель приватности] (* <- lang_ru;; *);;

// ---------------------------------------------------------------------
// Зависимости от источников знаний K_s и ресурсные ограничения L_s.
