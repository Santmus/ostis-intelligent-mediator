<- sc_node_class;
=> nrel_main_idtf:
    [зависимость от источника знаний] (* <- lang_ru;; *);
    [knowledge dependency] (* <- lang_en;; *);
=> nrel_idtf: [K_s];;

concept_resource_constraint
<- sc_node_class;
=> nrel_main_idtf:
    [ресурсное / временное / контекстное ограничение] (* <- lang_ru;; *);
    [resource constraint] (* <- lang_en;; *);
=> nrel_idtf: [L_s];;

concept_resource_constraint <= nrel_subdividing: ...
(*
    -> concept_constraint_cpu;
       concept_constraint_memory;
       concept_constraint_gpu;
       concept_constraint_network;
       concept_constraint_time_window;
       concept_constraint_context_scope;
       concept_constraint_data_residency;;
*);;

concept_constraint_cpu
<- sc_node_class;
=> nrel_main_idtf: [ограничение CPU] (* <- lang_ru;; *);;
concept_constraint_memory
<- sc_node_class;
=> nrel_main_idtf: [ограничение памяти] (* <- lang_ru;; *);;
concept_constraint_gpu
<- sc_node_class;
=> nrel_main_idtf: [ограничение GPU] (* <- lang_ru;; *);;
concept_constraint_network
<- sc_node_class;
