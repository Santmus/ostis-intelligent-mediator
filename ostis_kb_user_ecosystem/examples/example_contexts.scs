// =====================================================================
// examples/example_contexts.scs
// Эталонные композитные контексты и иллюстрация их эволюции.
// =====================================================================

section_example_contexts
=> nrel_main_idtf:
    [Подраздел. Примеры контекстов взаимодействия] (* <- lang_ru;; *);
    [Subsection. Example Interaction Contexts] (* <- lang_en;; *);
<- atomic_section;
<- rrel_key_sc_element: interaction_context_reference;
<- rrel_key_sc_element: interaction_context_structure;;

// ---------------------------------------------------------------------
// Эталонный композитный контекст.
// ---------------------------------------------------------------------

interaction_context_reference <- concept_interaction_context;;
interaction_context_reference => nrel_main_idtf:
    [Эталонный композитный контекст взаимодействия] (* <- lang_ru;; *);
    [Reference composite interaction context] (* <- lang_en;; *);;

interaction_context_structure <- sc_node_structure;;
interaction_context_structure => nrel_main_idtf:
    [Структура декомпозиции контекста взаимодействия] (* <- lang_ru;; *);;

interaction_context_reference => nrel_contains:
{
    interaction_context_structure;
    concept_goal_context;
    concept_history_context;
    concept_system_context;
    concept_domain_context;
    concept_user_situation_context
};;

// ---------------------------------------------------------------------
// Пример совместимости контекста с системой.
// ---------------------------------------------------------------------

ctx_compat_example_001 <- concept_context_compatibility_function;;
ctx_compat_example_001 => nrel_main_idtf:
    [Пример вычисления: ctx_compat(C_001, energy_model) =
     0.2·1.0 + 0.2·0.85 + 0.2·0.9 + 0.2·0.95 + 0.2·0.8 = 0.90]
    (* <- lang_ru;; *);;

interaction_context_001 => nrel_context_compatibility:
    intelligent_system_energy_model;;

// ---------------------------------------------------------------------
// Пример эволюции: цепочка контекстов.
// ---------------------------------------------------------------------

interaction_context_003 <- concept_interaction_context;;
interaction_context_003 <- concept_context_hypothesis;;
interaction_context_003 => nrel_context_version: [3];;
interaction_context_003 => nrel_context_timestamp: [2025-09-12T14:20:00Z];;
interaction_context_003 => nrel_main_idtf:
    [Контекст 003: после прибытия к промежуточной точке] (* <- lang_ru;; *);;
interaction_context_003 => nrel_context_inherits_from: interaction_context_002;;

event_intermediate_point <- concept_event_user_action;;
event_intermediate_point => nrel_main_idtf:
    [Событие: пользователь достиг промежуточной точки маршрута]
    (* <- lang_ru;; *);;
interaction_context_003 => nrel_context_updated_by_event:
    event_intermediate_point;;


interaction_context_reference => nrel_context_version: [1];;
interaction_context_reference => nrel_context_timestamp: [2025-09-12T14:00:00Z];;


// Явные пять компонентов эталонного и унаследованного контекстов.
reference_goal <- concept_goal;;
reference_goal_context <- concept_goal_context;;
reference_goal_context => nrel_contains: reference_goal;;
reference_history_context <- concept_history_context;;
reference_system_context <- concept_system_context;;
reference_domain_context <- concept_domain_context;;
reference_user_situation_context <- concept_user_situation_context;;
interaction_context_reference -> rrel_goal_context: reference_goal_context;;
interaction_context_reference -> rrel_history_context:
    reference_history_context;;
interaction_context_reference -> rrel_system_context:
    reference_system_context;;
interaction_context_reference -> rrel_domain_context:
    reference_domain_context;;
interaction_context_reference -> rrel_user_situation_context:
    reference_user_situation_context;;

ecosystem_state_003 <- concept_system_context;;
ecosystem_state_003 => nrel_main_idtf:
    [Системный контекст после прибытия к промежуточной точке]
    (* <- lang_ru;; *);;
interaction_context_003 -> rrel_goal_context: goal_context_route_planning;;
interaction_context_003 -> rrel_history_context: history_alice_001;;
interaction_context_003 -> rrel_system_context: ecosystem_state_003;;
interaction_context_003 -> rrel_domain_context: domain_logistics;;
interaction_context_003 -> rrel_user_situation_context:
    situation_alice_mobile_ru;;
